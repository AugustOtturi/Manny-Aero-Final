---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassButton from "../components/ui/GlassButton.astro";
---

<BaseLayout title="404 — Page not found | Manny Aero" activeLink="home">
  <Fragment slot="head">
    <script
      src="https://unpkg.com/@lottiefiles/lottie-player@2.0.8/dist/lottie-player.js"
      defer
    ></script>
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="notfound" aria-labelledby="notfound-title">
    <div class="container notfound__inner">
      <div class="notfound__lottie reveal" aria-hidden="true">
        <lottie-player
          src="https://assets3.lottiefiles.com/packages/lf20_x62chJ.json"
          background="transparent"
          speed="1"
          loop
          autoplay
        ></lottie-player>
      </div>

      <p class="notfound__code reveal">404</p>
      <h1 id="notfound-title" class="notfound__title reveal">
        Lost in the <span class="accent">airspace</span>?
      </h1>
      <p class="notfound__lead reveal">
        The page you were looking for couldn't be found — but our ops team is
        always reachable, 24/7.
      </p>

      <div class="notfound__cta reveal">
        <GlassButton href="/" variant="glass">
          <svg
            width="14"
            height="14"
            viewBox="0 0 18 18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M15 9H3M3 9L8 4M3 9L8 14"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Back to Home
        </GlassButton>
        <GlassButton href="/contact" variant="solid">
          Contact Us
          <svg
            width="14"
            height="14"
            viewBox="0 0 18 18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 9H15M15 9L10 4M15 9L10 14"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </GlassButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    position: relative;
    min-height: 100svh;
    max-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(96px, 12vh, 130px) var(--pad-x) clamp(36px, 5vh, 60px);
    overflow: hidden;
  }

  .notfound__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
    gap: clamp(8px, 1.4vh, 14px);
  }

  .notfound__lottie {
    /* Cap by both width AND viewport height so it never pushes the
       rest of the content past 100svh on short displays. */
    width: min(clamp(320px, 48vw, 560px), 46vh);
    height: min(clamp(320px, 48vw, 560px), 46vh);
    margin-bottom: clamp(4px, 0.6vh, 10px);
    /* Tint the Lottie to brand yellow (#ffb900-ish). The paper plane is
       a dark-blue silhouette; brightness(0)+invert(1) flattens it to
       white, then sepia+saturate+hue-rotate shifts it to gold. */
    filter:
      brightness(0)
      saturate(100%)
      invert(72%)
      sepia(91%)
      saturate(1320%)
      hue-rotate(2deg)
      brightness(106%)
      contrast(105%)
      drop-shadow(0 0 28px rgba(255, 185, 0, 0.45));
  }

  .notfound__lottie lottie-player {
    width: 100%;
    height: 100%;
  }

  .notfound__code {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 108px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 0.9;
    color: var(--color-accent);
    margin: 0;
    text-shadow:
      0 0 24px rgba(255, 185, 0, 0.45),
      0 0 60px rgba(255, 185, 0, 0.2);
  }

  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.8vw, 52px);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0;
  }

  .notfound__title .accent {
    color: var(--color-accent);
  }

  .notfound__lead {
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--color-text);
    max-width: 520px;
    margin: 0 0 clamp(8px, 1.6vh, 16px);
  }

  .notfound__cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .notfound {
      padding-top: clamp(84px, 11vh, 110px);
    }
    .notfound__cta {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }
    .notfound__cta :global(.gbtn) {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-height: 720px) {
    /* Short viewports: shrink the Lottie further so the CTAs stay in view */
    .notfound__lottie {
      width: min(clamp(220px, 32vw, 360px), 30vh);
      height: min(clamp(220px, 32vw, 360px), 30vh);
    }
    .notfound__code {
      font-size: clamp(56px, 9vw, 96px);
    }
  }
</style>
