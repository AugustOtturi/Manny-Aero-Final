---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listImages } from "../../../lib/server/repositories/images";

export const prerender = false;

const logos = await listImages("logo");
---

<AdminLayout title="Logos" active="images">
  <main class="page">
    <header class="page__header">
      <a href="/admin/images" class="page__back">← Imágenes</a>
      <h1>Logos de partners / eventos</h1>
    </header>
    <p class="page__lead">
      Estos logos aparecen en el carrusel de la página principal. Podés agregar nuevos, eliminar los que ya no apliquen, o reemplazar la imagen de uno existente.
    </p>

    <section class="add-form">
      <h2>Agregar logo nuevo</h2>
      <form id="add-form">
        <input type="file" name="file" accept="image/jpeg,image/png,image/webp" required />
        <button type="submit" id="add-submit">Agregar logo</button>
        <p class="status" id="add-status" hidden></p>
      </form>
    </section>

    <section class="grid" id="logos-grid">
      {logos.map((logo) => (
        <div class="card" data-slug={logo.slug}>
          <div class="card__preview">
            <img src={`/uploads/logo/${logo.fileName}`} alt="" />
          </div>
          <div class="card__body">
            <form class="replace-form">
              <input type="file" name="file" accept="image/jpeg,image/png,image/webp" />
              <button type="submit" class="btn-small">Reemplazar imagen</button>
            </form>
            <button class="delete-btn">Eliminar logo</button>
            <p class="card__status" hidden></p>
          </div>
        </div>
      ))}
      {logos.length === 0 && <p class="empty">No hay logos todavía — agrega el primero arriba.</p>}
    </section>
  </main>
</AdminLayout>

<script>
  const addForm = document.getElementById("add-form") as HTMLFormElement;
  const addStatus = document.getElementById("add-status")!;
  const addSubmit = document.getElementById("add-submit") as HTMLButtonElement;

  addForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    addStatus.hidden = true;
    addSubmit.disabled = true;

    const fd = new FormData(addForm);
    const file = fd.get("file") as File;
    if (!file || !file.size) {
      addStatus.hidden = false;
      addStatus.textContent = "Selecciona una imagen.";
      addStatus.style.color = "#ff6b6b";
      addSubmit.disabled = false;
      return;
    }

    const slug = `logo-${Date.now()}`;
    const uploadFd = new FormData();
    uploadFd.append("category", "logo");
    uploadFd.append("slug", slug);
    uploadFd.append("file", file);

    try {
      const res = await fetch("/api/admin/images/upload", { method: "POST", body: uploadFd });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || "Error al subir");
      window.location.reload();
    } catch (err) {
      addStatus.hidden = false;
      addStatus.textContent = err instanceof Error ? err.message : "Error inesperado";
      addStatus.style.color = "#ff6b6b";
      addSubmit.disabled = false;
    }
  });

  document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
    const slug = card.dataset.slug!;
    const status = card.querySelector<HTMLElement>(".card__status")!;
    const replaceForm = card.querySelector<HTMLFormElement>(".replace-form")!;
    const deleteBtn = card.querySelector<HTMLButtonElement>(".delete-btn")!;
    const preview = card.querySelector<HTMLElement>(".card__preview")!;

    function showStatus(msg: string, isError = false) {
      status.hidden = false;
      status.textContent = msg;
      status.style.color = isError ? "#ff6b6b" : "var(--color-accent)";
    }

    replaceForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const file = (new FormData(replaceForm).get("file") as File) ?? null;
      if (!file || !file.size) {
        showStatus("Selecciona un archivo primero.", true);
        return;
      }
      const fd = new FormData();
      fd.append("category", "logo");
      fd.append("slug", slug);
      fd.append("file", file);

      showStatus("Subiendo…");
      try {
        const res = await fetch("/api/admin/images/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || "Error al subir");
        preview.innerHTML = `<img src="/uploads/logo/${data.image.fileName}?t=${Date.now()}" alt="" />`;
        showStatus("Imagen actualizada.");
      } catch (err) {
        showStatus(err instanceof Error ? err.message : "Error inesperado", true);
      }
    });

    deleteBtn.addEventListener("click", async () => {
      const ok = await window.adminConfirm("Esta acción no se puede deshacer.", {
        title: "¿Eliminar este logo del carrusel?",
        confirmLabel: "Eliminar",
      });
      if (!ok) return;
      showStatus("Eliminando…");
      try {
        const res = await fetch(`/api/admin/images/logo/${slug}`, { method: "DELETE" });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || "Error al eliminar");
        card.remove();
      } catch (err) {
        showStatus(err instanceof Error ? err.message : "Error inesperado", true);
      }
    });
  });
</script>

<style>
  .page {
    padding: 40px 32px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .page__header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 8px;
  }

  .page__back {
    font-size: 13px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .page__header h1 {
    font-family: var(--font-display);
    font-size: 26px;
    margin: 0;
  }

  .page__lead {
    color: var(--color-text-muted);
    font-size: 14px;
    max-width: 640px;
    margin: 0 0 32px;
    opacity: 0.85;
  }

  .add-form {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 32px;
  }

  .add-form h2 {
    font-size: 15px;
    margin: 0 0 16px;
  }

  .add-form form {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .add-form input[type="file"] {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  #add-submit {
    padding: 11px 22px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: #0a0a0a;
    font-weight: 700;
    font-size: 13px;
    border: none;
    cursor: pointer;
  }

  #add-submit:disabled {
    opacity: 0.6;
  }

  .status {
    font-size: 12px;
    margin: 8px 0 0;
    width: 100%;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .card__preview {
    height: 110px;
    background: rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px;
  }

  .card__preview img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .card__body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 1px solid var(--color-border);
  }

  .replace-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .replace-form input[type="file"] {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .btn-small {
    align-self: flex-start;
    font-size: 12px;
    padding: 7px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-small:hover {
    border-color: var(--color-accent);
  }

  .delete-btn {
    align-self: flex-start;
    font-size: 12px;
    color: #ff6b6b;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .card__status {
    font-size: 11px;
    margin: 0;
  }

  .empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 32px;
    color: var(--color-text-muted);
  }
</style>
