---
// Back-to-services button — first element on every service page, above the hero.
---

<div class="back-bar">
  <div class="container">
    <a href="/#services" class="back-link" aria-label="Back to all services">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2.2"
              stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      All Services
    </a>
  </div>
</div>

<style>
  .back-bar {
    padding-top: 104px; /* clears fixed navbar */
    padding-bottom: 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px 9px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    border: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0a0a0a;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(255, 185, 0, 0.4);
    transition: background 0.2s var(--ease-out),
                box-shadow 0.2s var(--ease-out),
                gap 0.2s var(--ease-out),
                transform 0.2s var(--ease-out);
  }

  .back-link svg {
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-out);
  }

  .back-link:hover {
    background: var(--color-accent-hover);
    box-shadow: 0 6px 22px rgba(255, 185, 0, 0.55);
    transform: translateY(-1px);
    gap: 11px;
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  @media (max-width: 768px) {
    .back-bar {
      padding-top: 88px;
    }
  }
</style>
