---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import GlassButton from "../components/ui/GlassButton.astro";
import BackToServices from "../components/BackToServices.astro";
import salmonImg from "../assets/photos/catering.jpg";
import omeleteImg from "../assets/photos/catering4.jpg";
---

<BaseLayout
  title="In-Flight Catering Mexico — Manny's Catering"
  description="Premium in-flight catering for private and corporate aviation across Mexico. Custom gourmet menus, cabin services, floral arrangements, newspapers, and 24/7 coordination."
  ogImage="/og/catering.jpg"
  ogImageAlt="Premium in-flight catering service by Manny's Catering for private aviation in Mexico"
  activeLink="services"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FoodService",
      "name": "Manny's Catering — In-Flight Catering Mexico",
      "url": "https://manny.aero/catering",
      "description": "Premium in-flight catering service for private and corporate aviation throughout Mexico. Custom gourmet menus, cabin services, and 24/7 coordination.",
      "provider": {
        "@type": "Organization",
        "name": "Manny Aero",
        "url": "https://manny.aero"
      },
      "areaServed": { "@type": "Country", "name": "Mexico" },
      "serviceType": "In-Flight Catering",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "In-Flight Catering Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Customized in-flight menus" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Gourmet cuisine preparation" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cabin floral arrangements" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Laundry and dishwashing services" } }
        ]
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://manny.aero" },
        { "@type": "ListItem", "position": 2, "name": "Ground Handling", "item": "https://manny.aero/ground-handling" },
        { "@type": "ListItem", "position": 3, "name": "In-Flight Catering", "item": "https://manny.aero/catering" }
      ]
    })} />
  </Fragment>
  <BackToServices />
  <PageHero
    badge="In-Flight Catering"
    title="Premium In-flight Catering Across Mexico"
    subtitle="Manny's Catering provides tailored in-flight catering and cabin support solutions for private and corporate aviation throughout Mexico."
    accent="Across Mexico"
  />

  <!-- PHOTO BAND 1 -->
  <div class="photo-band reveal">
    <div class="container">
      <div class="photo-wrap">
        <Image
          src={salmonImg}
          alt="Manny's Catering — Premium in-flight cuisine"
          widths={[800, 1200, 1600]}
          sizes="(max-width: 1024px) 100vw, 1200px"
          loading="eager"
          class="band-photo"
        />
        <div class="band-overlay" aria-hidden="true" />
      </div>
    </div>
  </div>

  <!-- CONTENT -->
  <section class="catering-content section">
    <div class="container">
      <div class="catering-header reveal">
        <div class="section-label">Our Services</div>
        <h2 class="section-title">
          In-Flight Catering &amp; Cabin Services <span class="accent">Across Mexico</span>
        </h2>
      </div>
      <div class="catering-grid stagger">
        <div class="catering-body">
          <p>
            Based in Toluca and serving the center of the country, we coordinate catering
            services nationwide with a focus on quality, efficiency, presentation, and seamless
            execution. From carefully curated gourmet menus to personalized requests for crew
            and passengers, every detail is managed with precision and care.
          </p>
          <p>
            Designed to support the standards of modern business aviation, Manny's Catering
            delivers a refined onboard experience backed by reliable coordination and
            personalized service.
          </p>
          <div class="menu-cta">
            <a href="https://online.fliphtml5.com/hckum/Menu-2026/" target="_blank" rel="noopener noreferrer" class="menu-btn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              Manny's Catering Menu
            </a>
          </div>
        </div>
        <div class="catering-card">
          <div class="list-title">What We Offer</div>
          <ul class="catering-list">
            <li>Customized menus for all dietary restrictions and preferences</li>
            <li>Fresh gourmet cuisine prepared with premium ingredients</li>
            <li>In-flight catering coordination across Mexico</li>
            <li>Laundry and dishwashing services</li>
            <li>Floral arrangements for your cabin</li>
            <li>Access to more than 300 international newspapers</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PHOTO BAND 2 -->
  <div class="photo-band photo-band--sm reveal">
    <div class="container">
      <div class="photo-wrap">
        <Image
          src={omeleteImg}
          alt="Gourmet in-flight catering by Manny's Catering"
          widths={[800, 1200, 1600]}
          sizes="(max-width: 1024px) 100vw, 1200px"
          loading="lazy"
          class="band-photo band-photo--sm"
        />
        <div class="band-overlay" aria-hidden="true" />
      </div>
    </div>
  </div>

  <!-- CTA -->
  <section class="catering-cta section">
    <div class="container">
      <div class="catering-cta-inner reveal">
        <div class="catering-cta-label">Available 24/7</div>
        <h2 class="catering-cta-title">
          In-Flight Catering, <span class="accent">Expertly Coordinated</span>
        </h2>
        <p class="catering-cta-sub">
          24/7 support for customized catering solutions designed around your operation.
        </p>
        <div class="catering-cta-actions">
          <GlassButton href="/contact" variant="solid">Contact our team</GlassButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── PHOTO BANDS ── */
  .photo-band {
    padding-block: clamp(24px, 4vh, 48px);
  }

  .photo-band--sm {
    padding-block: clamp(16px, 3vh, 32px);
  }

  .photo-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.5),
      inset 0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  .band-photo {
    width: 100%;
    height: clamp(280px, 40vw, 520px);
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .band-photo--sm {
    height: clamp(200px, 28vw, 360px);
  }

  .band-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.35) 100%);
    pointer-events: none;
  }

  /* ── CONTENT ── */
  .section-label {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .section-label::before {
    content: "";
    width: 22px;
    height: 1px;
    background: var(--color-accent);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.5vw, 48px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0 0 40px;
  }

  .catering-header {
    margin-bottom: 48px;
  }

  .catering-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .catering-body p {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.85;
    margin-bottom: 22px;
  }

  /* ── SERVICES CARD ── */
  .catering-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 36px 40px;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 110px;
  }

  .list-title {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 20px;
  }

  .catering-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .catering-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .catering-list li::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    margin-top: 7px;
  }

  /* ── CTA ── */
  .catering-cta {
    text-align: center;
  }

  .catering-cta-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .catering-cta-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .catering-cta-label::before,
  .catering-cta-label::after {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }

  .catering-cta-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.05;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .catering-cta-sub {
    font-size: var(--fs-lead);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 32px;
  }

  .catering-cta-actions {
    display: flex;
    justify-content: center;
  }

  /* ── MENU BUTTON ── */
  .menu-cta {
    margin-top: 32px;
  }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 24px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s var(--ease-out);
    box-shadow: 0 6px 20px rgba(255, 185, 0, 0.35);
  }
  .menu-btn:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(255, 185, 0, 0.45);
  }
  .menu-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    flex-shrink: 0;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .catering-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .catering-card {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .catering-card {
      padding: 24px 20px;
    }
  }
</style>
