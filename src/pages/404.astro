---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassButton from "../components/ui/GlassButton.astro";
---

<BaseLayout title="404 — Page not found | Manny Aero" activeLink="home">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="notfound" aria-labelledby="notfound-title">
    <div class="container notfound__inner">
      <p class="notfound__code reveal">404</p>
      <h1 id="notfound-title" class="notfound__title reveal">
        Lost in the <span class="accent">airspace</span>?
      </h1>
      <p class="notfound__lead reveal">
        The page you were looking for couldn't be found — but our ops team is
        always reachable, 24/7.
      </p>

      <div class="notfound__cta reveal">
        <GlassButton href="/" variant="glass">
          <svg
            width="14"
            height="14"
            viewBox="0 0 18 18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M15 9H3M3 9L8 4M3 9L8 14"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          Back to Home
        </GlassButton>
        <GlassButton href="/contact" variant="solid">
          Contact Us
          <svg
            width="14"
            height="14"
            viewBox="0 0 18 18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 9H15M15 9L10 4M15 9L10 14"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </GlassButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    position: relative;
    min-height: 100svh;
    max-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(96px, 12vh, 130px) var(--pad-x) clamp(36px, 5vh, 60px);
    overflow: hidden;
  }

  .notfound__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 760px;
    width: 100%;
    gap: clamp(14px, 2.4vh, 28px);
  }

  .notfound__code {
    font-family: var(--font-display);
    font-size: clamp(140px, 22vw, 280px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.85;
    color: var(--color-accent);
    margin: 0;
    text-shadow:
      0 0 36px rgba(255, 185, 0, 0.5),
      0 0 90px rgba(255, 185, 0, 0.22);
  }

  .notfound__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.8vw, 52px);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0;
  }

  .notfound__title .accent {
    color: var(--color-accent);
  }

  .notfound__lead {
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--color-text);
    max-width: 520px;
    margin: 0 0 clamp(8px, 1.6vh, 16px);
  }

  .notfound__cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .notfound {
      padding-top: clamp(84px, 11vh, 110px);
    }
    .notfound__cta {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }
    .notfound__cta :global(.gbtn) {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-height: 720px) {
    /* Short viewports: shrink the 404 so the CTAs stay in view */
    .notfound__code {
      font-size: clamp(110px, 18vw, 200px);
    }
  }
</style>
