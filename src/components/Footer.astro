---
import { Image } from "astro:assets";
import mannyLogo from "../assets/mannylogo.png";

const socials = [
  { label: "Instagram", href: "https://www.instagram.com/manny_aero/" },
  { label: "Facebook",  href: "https://www.facebook.com/mannyaviation/" },
  { label: "LinkedIn",  href: "https://www.linkedin.com/company/manny-aviation-services/" },
  { label: "YouTube",   href: "https://www.youtube.com/@manny_aero" },
  { label: "TikTok",    href: "https://www.tiktok.com/@manny.aero" },
  { label: "X",         href: "https://x.com/manny_aero" },
];

const navLinks = [
  { label: "Home",       href: "/" },
  { label: "Ground Handling", href: "/ground-handling" },
  { label: "IS-BAH",     href: "/isbah" },
  { label: "Permits",    href: "/permits-and-authorizations" },
  { label: "About",      href: "/about" },
  { label: "News",       href: "/news" },
  { label: "Contact",    href: "/contact" },
];

const offices = [
  { city: "Toluca, México",              addr: "Blvd. Miguel Alemán S/N, C.P. 50226" },
  { city: "Querétaro, México",           addr: "Carr. 200, KM. 13.5, C.P. 76295" },
  { city: "Tapachula, México",           addr: "Puerto Madero, Km 18.5, C.P. 30830" },
  { city: "Felipe Carrillo Puerto, México", addr: "Carr. 307, Km 201, Ejido Chunyaxché" },
  { city: "Mérida, México",              addr: "Carr. Mérida–Umán, Km. 4.5, C.P. 97291" },
  { city: "Cozumel, México",             addr: "Carr. Aeropuerto Internacional, C.P. 77600" },
  { city: "Cancún, México",              addr: "Carr. Cancún–Chetumal, Km. 22, C.P. 77569" },
  { city: "Guadalajara, México",         addr: "Carr. Guadalajara–Chapala, Km 17.5, C.P. 45659" },
];
---

<footer class="footer">
  <!-- TOP GRID -->
  <div class="footer__top container">

    <!-- COL 1: Brand -->
    <div class="footer__brand">
      <Image src={mannyLogo} alt="Manny Aero" class="footer__logo" width={512} height={512} loading="lazy" decoding="async" />
      <p class="footer__tagline">
        Ground Handling &amp; FBO Coordination Across Mexico
      </p>
      <div class="footer__socials">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
        ))}
      </div>
    </div>

    <!-- COL 2: Navigation -->
    <nav class="footer__nav" aria-label="Footer navigation">
      <div class="footer__col-label">Navigation</div>
      <ul class="footer__nav-list">
        {navLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- COL 3: Contact -->
    <div class="footer__contact">
      <div class="footer__col-label">Contact</div>
      <div class="footer__emails">
        <a href="mailto:ops@manny.aero">ops@manny.aero</a>
        <a href="mailto:admon@manny.aero">admon@manny.aero</a>
        <a href="mailto:info@manny.aero">info@manny.aero</a>
      </div>
      <div class="footer__phones">
        <a href="tel:+527222730981">MEX +52 722 273 0981</a>
        <a href="tel:+18775062669">US &amp; CAN 1 877 50 MANNY</a>
      </div>
    </div>

    <!-- COL 4: Offices -->
    <div class="footer__offices">
      <div class="footer__col-label">Offices</div>
      <div class="footer__offices-list">
        {offices.map((o) => (
          <div class="footer__office">
            <div class="footer__office-city">{o.city}</div>
            <div class="footer__office-addr">{o.addr}</div>
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- MEMBERS BAND -->
  <div class="footer__members">
    <div class="footer__members-inner container">
      <span class="footer__members-label">Proud Member of the Following Organizations</span>
      <div class="footer__members-logos">
        <img src="/member-logos/aircharter.png" alt="Air Charter Association" class="footer__member-logo" />
        <img src="/member-logos/cbaaacaa.png"   alt="CBAA / ACAA"            class="footer__member-logo" />
        <img src="/member-logos/ibac.png"       alt="IBAC"                   class="footer__member-logo" />
        <img src="/member-logos/nbaa.png"       alt="NBAA"                   class="footer__member-logo" />
        <img src="/member-logos/mgaa.png"       alt="MGAA"                   class="footer__member-logo" />
        <img src="/member-logos/aca.svg"        alt="ACA"                    class="footer__member-logo" />
      </div>
    </div>
  </div>

  <!-- BOTTOM BAR -->
  <div class="footer__bottom">
    <div class="footer__bottom-inner container">
      <span class="footer__copyright">MANNY © 2026.</span>
      <div class="footer__legal">
        <a href="/PRIVACYPOLICY.pdf" target="_blank" rel="noopener noreferrer">Privacy Notice</a>
        <a href="/TermsConditions.pdf" target="_blank" rel="noopener noreferrer">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-footer);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ── TOP GRID ── */
  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.5fr 1.5fr;
    gap: 48px;
    align-items: start;
    padding-block: clamp(48px, 6vw, 80px);
  }

  /* ── COLUMN LABEL ── */
  .footer__col-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .footer__col-label::before {
    content: "";
    width: 14px;
    height: 1px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── BRAND ── */
  .footer__logo {
    height: 86px;
    width: auto;
    display: block;
    margin-bottom: 20px;
  }

  .footer__tagline {
    font-size: 13px;
    color: var(--color-text-dim);
    line-height: 1.65;
    margin: 0 0 24px;
    max-width: 28ch;
    letter-spacing: 0.02em;
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }
  .footer__socials a {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    transition: color 0.2s var(--ease-out);
  }
  .footer__socials a:hover {
    color: var(--color-accent);
  }

  /* ── NAV ── */
  .footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer__nav-list a {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    transition: color 0.2s var(--ease-out);
  }
  .footer__nav-list a:hover {
    color: var(--color-text);
  }

  /* ── CONTACT ── */
  .footer__emails {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .footer__emails a {
    font-size: 13px;
    color: var(--color-text-dim);
    letter-spacing: 0.02em;
    transition: color 0.2s var(--ease-out);
  }
  .footer__emails a:hover {
    color: var(--color-text);
  }

  .footer__phones {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer__phones a {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    transition: color 0.2s var(--ease-out);
  }
  .footer__phones a:hover {
    color: var(--color-accent-hover);
  }

  /* ── OFFICES ── */
  .footer__offices-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 20px;
  }
  .footer__office-city {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 3px;
  }
  .footer__office-addr {
    font-size: 12px;
    color: var(--color-text-dim);
    line-height: 1.55;
  }

  /* ── MEMBERS BAND ── */
  .footer__members {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 32px;
  }
  .footer__members-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .footer__members-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    text-align: center;
  }
  .footer__members-logos {
    /* Fixed 3-per-row grid on desktop (2 rows of 3) — reads as an intentional
       layout and doesn't depend on all six fitting one line. Collapses to 2
       columns on tablet and 1 on mobile below. */
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    justify-items: center;
    align-items: center;
    gap: 34px 48px;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }
  .footer__member-logo {
    /* Fit each logo inside a box instead of fixing only the height — logos have
       different aspect ratios and internal padding, so height-only made the
       wider / tightly-cropped ones (MGAA, ACA) read as larger. */
    max-height: 90px;
    max-width: 180px;
    width: auto;
    height: auto;
    opacity: 0.6;
    filter: brightness(0) invert(1);
    transition: opacity 0.2s var(--ease-out);
  }
  .footer__member-logo:hover {
    opacity: 1;
  }
  @media (max-width: 820px) {
    .footer__members-logos {
      grid-template-columns: repeat(2, 1fr);
      max-width: 460px;
    }
  }
  @media (max-width: 480px) {
    .footer__members-logos {
      gap: 24px 28px;
      max-width: 340px;
    }
    .footer__member-logo {
      max-height: 70px;
      max-width: 130px;
    }
  }

  /* ── BOTTOM BAR ── */
  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 18px;
  }
  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .footer__copyright {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }
  .footer__legal {
    display: flex;
    gap: 20px;
  }
  .footer__legal a {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    transition: color 0.2s var(--ease-out);
  }
  .footer__legal a:hover {
    color: var(--color-text);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1200px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 40px 48px;
    }
  }

  @media (max-width: 640px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }
  }

  @media (max-width: 480px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer__bottom-inner {
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-align: center;
    }
    .footer__legal {
      justify-content: center;
    }
  }
</style>
