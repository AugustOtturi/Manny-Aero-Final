---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import StatsBand from "../components/StatsBand.astro";
import GlassButton from "../components/ui/GlassButton.astro";

const stats = [
  { value: "25+", label: "Years in operation" },
  { value: "70+", label: "Airports covered" },
  { value: "4,000+", label: "Permits processed" },
  { value: "24/7", label: "Operations support" },
];

const timeline = [
  {
    year: "1997",
    event: "Founded in Toluca, Mexico",
    desc: "Manny Aviation Services was founded with a vision to deliver world-class ground handling and aviation support services throughout the country.",
  },
  {
    year: "2011–2013",
    event: "Best FBO Mexican Handler",
    desc: "Honored three consecutive years as “Best FBO Mexican Handler”, reinforcing Manny's reputation as a trusted aviation partner in Mexico.",
  },
  {
    year: "2016",
    event: "IS-BAH Certified",
    desc: "After more than two years of preparation, Manny became the first ground-support coordination company in Mexico to obtain IS-BAH safety certification.",
  },
  {
    year: "2026",
    event: "10 Years of IS-BAH",
    desc: "Manny proudly celebrates a decade of IS-BAH certification, reaffirming its commitment to the highest international standards of safety and operational excellence.",
  },
];

const values = [
  {
    num: "01",
    title: "Service That Goes Beyond Expectations",
    desc: "At Manny, every operation is managed with dedication, professionalism, and genuine care. Our team is committed to delivering seamless support and creating an experience defined by trust, efficiency, and excellence.",
  },
  {
    num: "02",
    title: "Local Knowledge Matters",
    desc: "Mexico is complex — our experience, relationships, and on-the-ground expertise allow us to navigate it with speed, precision, and confidence.",
  },
  {
    num: "03",
    title: "Safety Drives Everything",
    desc: "As the first ground-support coordination company in Mexico to obtain IS-BAH certification, safety is embedded into every decision, process, and operation we manage.",
  },
];
---

<BaseLayout
  title="About Manny Aero — Aviation Ground Handling Since 1997"
  description="Since 1997, Manny Aero has delivered world-class ground handling, permits, and aviation support across Mexico. IS-BAH certified. Meet the team behind every operation."
  ogImage="/og/about.jpg"
  ogImageAlt="Manuel RomeroVargas, CEO and founder of Manny Aero"
  activeLink="about"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://manny.aero" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://manny.aero/about" }
      ]
    })} />
  </Fragment>
  <PageHero
    badge="Our Story"
    title="Mexico-Based. Globally Trusted."
    subtitle="Delivering seamless ground handling support with unmatched operational expertise, proactive coordination, and world-class service — anytime, anywhere in Mexico."
    accent="Globally Trusted."
  />

  <StatsBand stats={stats} />

  <!-- STORY -->
  <section class="story-section section">
    <div class="container story-grid">
      <div class="story-sticky reveal">
        <div class="section-label">Who we are</div>
        <h2 class="section-title">
          Mexico's Premier<br /><span class="accent">Ground Support</span><br />Partner Since 1997.
        </h2>
      </div>
      <div class="story-body reveal">
        <p>
          For more than 25 years, Manny has built its reputation on trust, operational excellence,
          and personalized attention. Since 1997, we have supported business and private aviation
          throughout Mexico with a commitment to safety, quality, and seamless execution at every
          stage of the operation.
        </p>
        <p>
          What began as a vision to provide unparalleled ground handling coordination has evolved
          into one of Mexico's most trusted aviation support companies. Today, our experienced team
          continues to deliver world-class solutions with professionalism, proactive communication,
          and an unwavering dedication to international standards.
        </p>
        <div class="story-pull">
          "Exceptional service is not just what we do — it is who we are."
        </div>
        <p>
          At Manny, every client, partner, and crew member is treated with the highest level of
          care and attention — because exceptional service is not just what we do, it is who we are.
        </p>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="timeline-section section">
    <div class="container">
      <div class="timeline-header reveal">
        <div class="section-label">Our history</div>
        <h2 class="section-title">Key <span class="accent">milestones</span></h2>
      </div>
      <div class="timeline stagger stagger--fade">
        {
          timeline.map((item) => (
            <div class="timeline-item">
              <div class="timeline-year">{item.year}</div>
              <div class="timeline-event">{item.event}</div>
              <div class="timeline-desc">{item.desc}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="values-section section">
    <div class="container">
      <div class="values-header reveal">
        <div class="section-label">What drives us</div>
        <h2 class="section-title">Our <span class="accent">principles</span></h2>
      </div>
      <div class="values-grid stagger stagger--fade">
        {
          values.map((v) => (
            <div class="value-item">
              <div class="value-num">{v.num}</div>
              <div class="value-title">{v.title}</div>
              <div class="value-desc">{v.desc}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="about-cta section">
    <div class="container">
      <div class="about-cta__inner reveal">
        <div class="section-label about-cta__label">Coordinate Your Next Operation</div>
        <h2 class="section-title about-cta__title">
          Flying into Mexico? <span class="accent">We handle everything.</span>
        </h2>
        <p class="about-cta__sub">
          From permits to ground handling, our team takes care of every detail.
        </p>
        <div class="about-cta__actions">
          <GlassButton href="/contact" variant="solid">
            Contact our team
          </GlassButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-label {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .section-label::before {
    content: "";
    width: 22px;
    height: 1px;
    background: var(--color-accent);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 24px;
  }

  /* STORY */
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .story-sticky {
    position: sticky;
    top: 110px;
  }
  .story-body p {
    font-size: var(--fs-body);
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.85;
    margin-bottom: 22px;
  }
  .story-body p:last-child {
    margin-bottom: 0;
  }
  .story-pull {
    font-size: var(--fs-h3);
    font-weight: 400;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.4;
    border-left: 2px solid var(--color-accent);
    padding-left: 24px;
    margin: 32px 0;
  }

  /* TIMELINE */
  .timeline-header {
    margin-bottom: 48px;
  }
  .timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .timeline-item {
    background: var(--color-surface);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: background-color 0.25s var(--ease-out);
  }
  .timeline-item:hover {
    background: var(--color-surface-hover);
  }
  .timeline-year {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 400;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .timeline-event {
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }
  .timeline-desc {
    font-size: 15px;
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* VALUES */
  .values-header {
    margin-bottom: 48px;
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .value-item {
    background: var(--color-surface);
    padding: 32px 28px;
    transition: background-color 0.25s var(--ease-out);
  }
  .value-item:hover {
    background: var(--color-surface-hover);
  }
  .value-num {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.18em;
    color: var(--color-accent);
    margin-bottom: 16px;
  }
  .value-title {
    font-size: var(--fs-h3);
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-text);
    margin-bottom: 12px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .value-desc {
    font-size: var(--fs-body);
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  /* CTA */
  .about-cta__inner {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }
  .about-cta__label {
    justify-content: center;
  }
  .about-cta__label::before,
  .about-cta__label::after {
    content: "";
    width: 22px;
    height: 1px;
    background: var(--color-accent);
  }
  .about-cta__title {
    font-size: clamp(32px, 4.2vw, 56px);
  }
  .about-cta__sub {
    font-size: var(--fs-lead);
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 32px;
  }
  .about-cta__actions {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .story-sticky {
      position: static;
    }
    .timeline {
      grid-template-columns: repeat(2, 1fr);
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .timeline {
      grid-template-columns: 1fr;
    }
  }
</style>
