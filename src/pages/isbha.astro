---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassButton from "../components/ui/GlassButton.astro";
import GlassPill from "../components/ui/GlassPill.astro";
import BackToServices from "../components/BackToServices.astro";
import auditImg from "../assets/photos/isbaoisbah.jpg";
---

<BaseLayout
  title="IS-BAH & IS-BAO Audit Services — Manny Aero"
  description="Manny helps organizations achieve IS-BAH and IS-BAO compliance through expert consulting, SMS implementation, and audit preparation across Mexico."
  activeLink="services"
>
  <BackToServices />

  <!-- HERO SPLIT -->
  <section class="isbah-hero">
    <div class="container">
      <div class="isbah-hero__grid">
        <div class="isbah-hero__content">
          <div class="hero-enter" style="--enter-delay: 0ms">
            <GlassPill class="isbah-hero__badge">Audit Services</GlassPill>
          </div>
          <h1 class="isbah-hero__title hero-enter" style="--enter-delay: 120ms">
            IS-BAH &amp; <span class="accent">IS-BAO</span> Audit Services
          </h1>
          <p class="isbah-hero__sub hero-enter" style="--enter-delay: 240ms">Safety First. Excellence Always.</p>
          <p class="isbah-hero__body hero-enter" style="--enter-delay: 360ms">
            With Manny, aviation safety is more than a standard — it's the foundation of every
            operation. We help organizations achieve internationally recognized compliance through
            expert guidance, operational excellence, and a strong safety culture.
          </p>
        </div>
        <div class="isbah-hero__photo-wrap hero-enter" style="--enter-delay: 80ms">
          <Image
            src={auditImg}
            alt="IS-BAH & IS-BAO Audit Services — Manny Aero"
            widths={[800, 1200, 1600]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="eager"
            class="isbah-hero__photo"
          />
          <div class="isbah-hero__overlay" aria-hidden="true" />
        </div>
      </div>
    </div>
  </section>

  <!-- IS-BAH -->
  <section class="audit-section section section--tight-top" id="isbah">
    <div class="container">
      <div class="audit-header reveal">
        <div class="section-label">IS-BAH Audits</div>
        <h2 class="section-title">
          International Safety Standards for <span class="accent">Ground Handling Operations</span>
        </h2>
      </div>
      <div class="audit-grid stagger">
        <div class="audit-body">
          <p>
            We help Ground Handling Service Providers Worldwide, FBOs, and Business Aircraft
            Handling Agencies achieve IS-BAH compliance through expert consulting, SMS
            implementation, and audit preparation.
          </p>
          <p>
            Our team supports your organization through every stage of certification, helping
            you improve operational safety, strengthen compliance, and build customer confidence.
          </p>
          <div class="list-block">
            <div class="list-title">What We Deliver</div>
            <ul class="audit-list">
              <li>IS-BAH readiness assessments</li>
              <li>SMS implementation support</li>
              <li>Audit preparation</li>
              <li>Operational procedure reviews</li>
              <li>Safety culture development</li>
              <li>Stage 1, 2 &amp; 3 support</li>
            </ul>
          </div>
        </div>
        <div class="why-card">
          <div class="list-title">Why IS-BAH</div>
          <ul class="audit-list">
            <li>Internationally recognized safety standard</li>
            <li>Improved operational efficiency</li>
            <li>Stronger risk management</li>
            <li>Enhanced client trust</li>
            <li>ICAO SMS alignment</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DIVIDER -->
  <div class="section-divider" aria-hidden="true"></div>

  <!-- IS-BAO -->
  <section class="audit-section section" id="isbao">
    <div class="container">
      <div class="audit-header reveal">
        <div class="section-label">IS-BAO Audits</div>
        <h2 class="section-title">
          The Global Standard for <span class="accent">Business Aviation Operations</span>
        </h2>
      </div>
      <div class="audit-grid stagger">
        <div class="audit-body">
          <p>
            We support operators in achieving IS-BAO compliance with tailored consulting,
            operational reviews, and Safety Management System implementation.
          </p>
          <p>
            From single aircraft operations to international fleets, we help organizations
            elevate safety performance and meet internationally recognized aviation standards.
          </p>
          <div class="list-block">
            <div class="list-title">Our Services</div>
            <ul class="audit-list">
              <li>IS-BAO implementation</li>
              <li>SMS development</li>
              <li>Compliance assessments</li>
              <li>Internal audit preparation</li>
              <li>Operational manual review</li>
              <li>Stage 1, 2 &amp; 3 support</li>
              <li>RPAS (remotely piloted aircraft systems) Audits</li>
            </ul>
          </div>
        </div>
        <div class="why-card">
          <div class="list-title">Benefits</div>
          <ul class="audit-list">
            <li>Stronger safety culture</li>
            <li>Increased operational efficiency</li>
            <li>International credibility</li>
            <li>Enhanced client confidence</li>
            <li>Continuous operational improvement</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="isbha-cta section">
    <div class="container">
      <div class="isbha-cta-inner reveal">
        <div class="isbha-cta-label">Get in touch</div>
        <h2 class="isbha-cta-title">
          Build a Safer, <span class="accent">Stronger Operation</span>
        </h2>
        <p class="isbha-cta-sub">
          Get in touch with our team to begin your IS-BAH or IS-BAO implementation and achieve
          internationally recognized safety standards.
        </p>
        <div class="isbha-cta-actions">
          <GlassButton href="/contact" variant="solid">Contact our team</GlassButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── HERO SPLIT ── */
  .isbah-hero {
    padding-top: clamp(100px, 14vh, 160px);
    padding-bottom: clamp(16px, 2vh, 24px);
  }

  .isbah-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .isbah-hero__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .isbah-hero__title {
    font-family: var(--font-display);
    font-size: clamp(38px, 4.5vw, 62px);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.0;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .isbah-hero__sub {
    font-size: var(--fs-lead);
    color: var(--color-text-muted);
    font-weight: 400;
    margin: 0;
  }

  .isbah-hero__body {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.85;
    margin: 0;
  }

  .isbah-hero__photo-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.5),
      inset 0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  .isbah-hero__photo {
    width: 100%;
    height: clamp(380px, 48vw, 560px);
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .isbah-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.38) 100%);
    pointer-events: none;
  }

  /* ── TIGHT TOP (first section after hero) ── */
  .section--tight-top {
    padding-top: clamp(24px, 3vh, 40px);
  }

  /* ── SECTION LABEL ── */
  .section-label {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .section-label::before {
    content: "";
    width: 22px;
    height: 1px;
    background: var(--color-accent);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.5vw, 48px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0 0 40px;
  }

  /* ── AUDIT SECTIONS ── */
  .audit-header {
    margin-bottom: 48px;
  }

  .audit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .audit-body p {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.85;
    margin-bottom: 22px;
  }

  .list-block {
    margin-top: 32px;
  }

  .list-title {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .audit-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .audit-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .audit-list li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    margin-top: 8px;
  }

  /* ── WHY CARD ── */
  .why-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 36px 40px;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 110px;
  }

  /* ── DIVIDER ── */
  .section-divider {
    height: 1px;
    background: var(--color-border);
    margin-inline: auto;
    max-width: var(--container);
    width: calc(100% - 48px);
  }

  /* ── CTA ── */
  .isbha-cta {
    text-align: center;
  }
  .isbha-cta-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .isbha-cta-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .isbha-cta-label::before,
  .isbha-cta-label::after {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }
  .isbha-cta-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.05;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .isbha-cta-sub {
    font-size: var(--fs-lead);
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 32px;
  }
  .isbha-cta-actions {
    display: flex;
    justify-content: center;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1024px) {
    .isbah-hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .isbah-hero__photo-wrap {
      order: -1;
    }
    .audit-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .why-card {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .why-card {
      padding: 24px 20px;
    }
  }
</style>
