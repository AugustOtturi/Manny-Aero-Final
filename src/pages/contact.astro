---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { AIRPORT_OPTIONS } from "../data/airportOptions";

const airportOptions = AIRPORT_OPTIONS;
---

<BaseLayout
  title="Contact Manny Aero — 24/7 Ground Handling Support Mexico"
  description="Reach Manny Aero's operations team 24/7 for ground handling, permits, and flight coordination across Mexico. US toll-free: +1-877-506-2669 | Mexico: +52-722-273-0981."
  activeLink="contact"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Manny Aero",
      "url": "https://manny.aero",
      "logo": "https://manny.aero/logo-manny.svg",
      "image": "https://manny.aero/og-default.jpg",
      "description": "Premium aircraft ground handling, permits, in-flight catering, and FBO coordination across Mexico. IS-BAH certified since 2016.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Toluca",
        "addressRegion": "Estado de México",
        "addressCountry": "MX",
        "postalCode": "50000"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 19.2826,
        "longitude": -99.5561
      },
      "telephone": ["+1-877-506-2669", "+52-722-273-0981"],
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      },
      "sameAs": [
        "https://www.instagram.com/manny_aero/",
        "https://www.facebook.com/mannyaviation/",
        "https://www.linkedin.com/company/manny-aviation-services/"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://manny.aero" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://manny.aero/contact" }
      ]
    })} />
  </Fragment>
  <PageHero
    badge="Get in touch"
    title="Contact Us"
    subtitle="Supporting your operation 24/7 with seamless coordination across Mexico."
    accent="Us"
  >
  </PageHero>

  <section class="contact-section section">
    <div class="container page-layout">
      <!-- FORM -->
      <div class="form-col">
        <div class="form-intro reveal">
          <h2 class="form-title">
            Let's Coordinate <span class="accent">Your Mission</span>
          </h2>
          <p class="form-sub">
            Share your itinerary and our operations team will assist you as soon as possible.
          </p>
        </div>

        <div class="form-card reveal">
          <form class="contact-form" id="contactForm" novalidate>
            {/* Honeypot — hidden from humans, bots fill it automatically */}
            <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form-divider">Your Information</div>
            <div class="form-row">
              <label class="field">
                <span>First Name</span>
                <input type="text" name="firstName" placeholder="John" required />
              </label>
              <label class="field">
                <span>Last Name</span>
                <input type="text" name="lastName" placeholder="Smith" required />
              </label>
            </div>
            <div class="form-row">
              <label class="field">
                <span>Email</span>
                <input type="email" name="email" placeholder="john@operator.com" required />
              </label>
              <label class="field">
                <span>Phone / WhatsApp</span>
                <input type="tel" name="phone" placeholder="+1 555 000 0000" />
              </label>
            </div>
            <label class="field field--full">
              <span>Company / Operator</span>
              <input type="text" name="company" placeholder="Aviation Company LLC" />
            </label>

            <div class="form-divider">Flight Details</div>
            <label class="field field--full">
              <span>Service Required</span>
              <select name="service">
                <option value="">Select a service…</option>
                <option>Ground Handling</option>
                <option>Landing / Overflight Permit</option>
                <option>Flight Planning &amp; Filing</option>
                <option>Jet Fuel Facilitation</option>
                <option>VIP Ground Transportation</option>
                <option>Gourmet In-flight Catering</option>
                <option>Crew Accommodation</option>
              </select>
            </label>
            <div class="flights" data-flights>
              <button type="button" class="flights__add" data-flights-add>
                <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path d="M9 3V15M3 9H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                Add Mission Information
              </button>
              <p class="flights__hint">
                Optional — share flight details so we can prepare everything in advance.
              </p>
              <div class="flights__list" data-flights-list></div>
            </div>
            <label class="field field--full">
              <span>Additional Notes</span>
              <textarea
                name="notes"
                rows="5"
                placeholder="Any special requirements, passenger count, crew details, or other information…"
              ></textarea>
            </label>

            <div class="form-footer field--full">
              <button type="submit" class="form-submit">
                Send Request
                <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path
                    d="M3 9H15M15 9L10 4M15 9L10 14"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <p class="form-note">
                For urgent requests:<br />
                US &amp; CAN <a href="tel:+18775062669">1 877 50 MANNY</a><br />
                MEX <a href="tel:+527222730981">+52 722 273 0981</a>
              </p>
            </div>
          </form>
        </div>

        <div class="form-success" id="formSuccess" aria-live="polite">
          <div class="success-inner">
            <div class="success-check">
              <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="success-title">Request received</div>
            <p class="success-desc">
              Thank you — your flight request has been sent to our operations team.
            </p>
            <div class="success-timeline">
              <div class="timeline-item">
                <span class="timeline-label">Contact</span>
                <span class="timeline-value"><a href="tel:+527222730981">MEX +52 722 273 0981</a> · <a href="tel:+18775062669">US 1 877 50 MANNY</a></span>
              </div>
            </div>
            <a href="/" class="success-cta">
              <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              Back to Home
            </a>
          </div>
        </div>

        <div class="form-error" id="formError" aria-live="assertive">
          <div class="error-inner">
            <div class="error-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </div>
            <div class="error-title">Request failed</div>
            <p class="error-desc" id="errorDesc">
              We couldn't send your request. Please try again or contact us directly.
            </p>
            <div class="error-timeline">
              <div class="timeline-item">
                <span class="timeline-label">Direct Phone</span>
                <span class="timeline-value"><a href="tel:+527222730981">MEX +52 722 273 0981</a> · <a href="tel:+18775062669">US 1 877 50 MANNY</a></span>
              </div>
              <div class="timeline-item">
                <span class="timeline-label">Email</span>
                <span class="timeline-value"><a href="mailto:ops@manny.aero">ops@manny.aero</a></span>
              </div>
            </div>
            <div class="error-actions">
              <button type="button" class="error-cta error-cta--primary" id="errorRetry">
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                Try again
              </button>
              <a href="tel:+527222730981" class="error-cta error-cta--secondary">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                Call us directly
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- SIDEBAR -->
      <aside class="sidebar reveal">
        <div class="contact-card">
          <div class="contact-card-label">Direct Line</div>
          <div class="contact-card-title">Operations Control Center</div>
          <div class="contact-card-body">
            Available 24 hours a day, 7 days a week, 365 days a year for urgent requests and
            real-time coordination.
          </div>
          <a href="tel:+527222730981" class="contact-card-link">
            MEX +52 722 273 0981
            <svg viewBox="0 0 24 24"
              ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"
              ></polyline></svg>
          </a>
          <a href="tel:+18775062669" class="contact-card-link">
            US &amp; CAN 1 877 50 MANNY
            <svg viewBox="0 0 24 24"
              ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"
              ></polyline></svg>
          </a>
        </div>
        <div class="contact-card">
          <div class="contact-card-label">Email</div>
          <div class="email-list">
            <div class="email-item">
              <div class="email-item-label">Operations Control Center</div>
              <a href="mailto:ops@manny.aero" class="contact-card-link">ops@manny.aero
                <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
            <div class="email-item">
              <div class="email-item-label">Administration &amp; Invoice</div>
              <a href="mailto:admon@manny.aero" class="contact-card-link">admon@manny.aero
                <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
            <div class="email-item">
              <div class="email-item-label">General Information</div>
              <a href="mailto:info@manny.aero" class="contact-card-link">info@manny.aero
                <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>
        </div>
        <div class="contact-card">
          <div class="contact-card-label">Main Offices</div>
          <div class="office-list">
            <div>
              <div class="office-item-name">Toluca, México</div>
              <div class="office-item-addr">
                Boulevard Miguel Alemán S/N San Pedro Totoltepec, Toluca, México. C.P. 50226
              </div>
            </div>
            <div>
              <div class="office-item-name">Querétaro, México</div>
              <div class="office-item-addr">
                Carretera No 200, KM. 13.5 Querétaro-Tequisquiapan, Colón, Querétaro. C.P. 76295
              </div>
            </div>
            <div>
              <div class="office-item-name">Tapachula, México</div>
            </div>
            <div>
              <div class="office-item-name">Felipe Carrillo Puerto, México</div>
            </div>
            <div>
              <div class="office-item-name">Mérida, México</div>
            </div>
            <div>
              <div class="office-item-name">Cozumel, México</div>
            </div>
            <div>
              <div class="office-item-name">Cancún, México</div>
              <div class="office-item-addr">
                Carretera Cancún–Chetumal, Km. 22. C.P. 77569, Cancún, Quintana Roo
              </div>
            </div>
            <div>
              <div class="office-item-name">Guadalajara, México</div>
            </div>
          </div>
        </div>
        <div class="map-placeholder" aria-hidden="true">
          <div class="map-placeholder-label">
            Mexico Operations<br />70+ airport coverage
          </div>
        </div>
      </aside>
    </div>
  </section>

<template id="flight-template-contact">
  <details class="flight" open>
    <summary class="flight__header">
      <span class="flight__chevron" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M3 5L6 8L9 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="flight__title" data-flight-title>Flight 1</span>
      <button type="button" class="flight__remove" aria-label="Remove flight" data-flight-remove>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M3 3L11 11M11 3L3 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </summary>
    <div class="flight__body">
      <label class="field">
        <span>PAX</span>
        <input type="number" min="0" inputmode="numeric" data-key="PAX" placeholder="e.g. 4" />
      </label>
      <label class="field">
        <span>Crew</span>
        <input type="number" min="0" inputmode="numeric" data-key="CREW" placeholder="e.g. 2" />
      </label>
      <label class="field">
        <span>Aircraft type</span>
        <input type="text" data-key="AIRCRAFT TYPE" placeholder="e.g. Gulfstream G550" />
      </label>
      <label class="field">
        <span>Tail number</span>
        <input type="text" data-key="TAIL NUMBER" placeholder="e.g. N12345" />
      </label>
      <label class="field">
        <span>Arrival date</span>
        <input type="date" data-key="ARRIVAL DATE" />
      </label>
      <label class="field">
        <span>Arrival time (UTC / Zulu)</span>
        <input type="text" data-key="ARRIVAL TIME" placeholder="e.g. 14:30Z" pattern="^([01]?[0-9]|2[0-3]):[0-5][0-9]Z?$" />
      </label>
      <label class="field">
        <span>Departure date</span>
        <input type="date" data-key="DEPARTURE DATE" />
      </label>
      <label class="field">
        <span>Departure time (UTC / Zulu)</span>
        <input type="text" data-key="DEPARTURE TIME" placeholder="e.g. 18:45Z" pattern="^([01]?[0-9]|2[0-3]):[0-5][0-9]Z?$" />
      </label>
      <label class="field field--select field--full">
        <span>Airport</span>
        <select data-key="AIRPORT">
          <option value="">Select an airport…</option>
        </select>
      </label>
    </div>
  </details>
</template>
</BaseLayout>

<script define:vars={{ airportOptions }}>
  const contactForm = document.getElementById("contactForm");
  const list = contactForm?.querySelector("[data-flights-list]");
  const addBtn = contactForm?.querySelector("[data-flights-add]");
  const template = document.getElementById("flight-template-contact");

  function reindex() {
    list?.querySelectorAll(".flight").forEach((flight, i) => {
      const title = flight.querySelector("[data-flight-title]");
      if (title) title.textContent = `Flight ${i + 1}`;
    });
  }

  function addFlight() {
    if (!template || !list) return;
    const node = template.content.cloneNode(true);
    const select = node.querySelector('select[data-key="AIRPORT"]');
    for (const opt of airportOptions) {
      const o = document.createElement("option");
      o.value = opt.value;
      o.textContent = opt.label;
      select.appendChild(o);
    }
    const other = document.createElement("option");
    other.value = "Other";
    other.textContent = "Other";
    select.appendChild(other);
    list.querySelectorAll(".flight").forEach((f) => { f.open = false; });
    list.appendChild(node);
    reindex();
  }

  if (addBtn) addBtn.addEventListener("click", addFlight);

  if (list) {
    list.addEventListener("click", (e) => {
      const removeBtn = e.target.closest("[data-flight-remove]");
      if (removeBtn) {
        e.preventDefault();
        e.stopPropagation();
        removeBtn.closest(".flight")?.remove();
        reindex();
      }
    });
  }
</script>

<script>
  const form    = document.getElementById("contactForm") as HTMLFormElement | null;
  const success = document.getElementById("formSuccess");
  const errorUI = document.getElementById("formError");
  const errorDesc = document.getElementById("errorDesc");
  const errorRetry = document.getElementById("errorRetry");
  const intro   = document.querySelector<HTMLElement>(".form-intro");
  const card    = document.querySelector<HTMLElement>(".form-card");
  const submitBtn = form?.querySelector<HTMLButtonElement>(".form-submit");

  function showError(msg: string) {
    if (!errorUI) return;
    if (errorDesc) {
      errorDesc.textContent = msg
        ? `We couldn't send your request: ${msg}. Please try again or contact us directly.`
        : "We couldn't send your request. Please try again or contact us directly.";
    }
    if (card)  card.style.display  = "none";
    if (intro) intro.style.display = "none";
    errorUI.classList.add("show");
  }

  function hideError() {
    if (!errorUI) return;
    errorUI.classList.remove("show");
    if (card)  card.style.display  = "";
    if (intro) intro.style.display = "";
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.style.opacity = "";
    }
  }

  errorRetry?.addEventListener("click", () => {
    hideError();
    card?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  if (form && success) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      // Collect standard fields
      const fd = new FormData(form);
      const payload: Record<string, unknown> = {
        type:      "contact",
        website:   (fd.get("website") as string) ?? "", // honeypot
        firstName: fd.get("firstName") ?? "",
        lastName:  fd.get("lastName")  ?? "",
        email:     fd.get("email")     ?? "",
        phone:     fd.get("phone")     ?? "",
        company:   fd.get("company")   ?? "",
        service:   fd.get("service")   ?? "",
        notes:     fd.get("notes")     ?? "",
      };

      // Collect flight repeater blocks
      const flightEls = form.querySelectorAll<HTMLElement>(".flight");
      const flights: Record<string, string>[] = [];
      flightEls.forEach((el) => {
        const block: Record<string, string> = {};
        el.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-key]").forEach((inp) => {
          const key = inp.dataset.key ?? "";
          if (key && inp.value.trim()) block[key] = inp.value.trim();
        });
        if (Object.keys(block).length > 0) flights.push(block);
      });
      payload.flights = flights;

      // Loading state
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = "0.65";
      }

      try {
        const res = await fetch("/mail.php", {
          method:  "POST",
          headers: { "Content-Type": "application/json" },
          body:    JSON.stringify(payload),
        });
        const json = await res.json();

        if (json.ok) {
          if (card)  card.style.display  = "none";
          if (intro) intro.style.display = "none";
          success.classList.add("show");
        } else {
          throw new Error(json.error ?? "Server error");
        }
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : "Unexpected error";
        showError(msg);
      }
    });
  }
</script>

<style>
  /* Availability badge under hero title */
  .hero-avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
    box-shadow: 0 6px 20px rgba(255, 185, 0, 0.35);
  }
  .hero-avail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #5ed19a;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px rgba(94, 209, 154, 0.25);
    animation: availPulse 2s infinite var(--ease-in-out);
  }
  @keyframes availPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(94, 209, 154, 0.25); }
    50%      { box-shadow: 0 0 0 7px rgba(94, 209, 154, 0); }
  }
  .hero-avail-text {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-avail-sep { color: rgba(255, 255, 255, 0.6); }
  .hero-avail-sub {
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
  }

  /* Layout */
  .page-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 56px;
    align-items: start;
  }

  .form-intro {
    margin-bottom: 32px;
  }
  .form-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .form-sub {
    font-size: var(--fs-lead);
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
    max-width: 56ch;
  }

  /* Form card (matches FinalCTA style) */
  .form-card {
    position: relative;
    background: linear-gradient(
      150deg,
      rgba(110, 110, 118, 0.42) 0%,
      rgba(60, 60, 68, 0.48) 55%,
      rgba(38, 38, 44, 0.55) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 40px);
    -webkit-backdrop-filter: blur(14px) saturate(1.25);
    backdrop-filter: blur(14px) saturate(1.25);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2),
      0 30px 80px rgba(0, 0, 0, 0.4),
      0 8px 24px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }
  .form-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at 15% 0%,
      rgba(255, 255, 255, 0.1) 0%,
      transparent 55%
    );
    border-radius: inherit;
  }
  .form-card > * {
    position: relative;
    z-index: 1;
  }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 20px;
  }
  .form-row {
    display: contents;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .field--full,
