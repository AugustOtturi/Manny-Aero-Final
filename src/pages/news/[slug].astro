---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import GlassButton from "../../components/ui/GlassButton.astro";
import { NEWS } from "../../data/news";

import ibacImg from "../../assets/photos/NOTICIA IBAC.webp";
import fifaImg from "../../assets/photos/FIFA.webp";
import nbaaImg from "../../assets/photos/NBAA-BACE.webp";

export function getStaticPaths() {
  return NEWS.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

const imageMap = {
  ibac: ibacImg,
  fifa: fifaImg,
  nbaa: nbaaImg,
};
---

<BaseLayout
  title={`${article.title} — Manny Aero`}
  description={article.excerpt}
  activeLink="news"
>
  <PageHero
    badge={article.category}
    title={article.title}
    subtitle={article.date}
    accent=""
  />

  <!-- Feature image -->
  <div class="article-photo-band">
    <div class="container">
      <div class="article-photo-wrap reveal">
        <Image
          src={imageMap[article.imageKey]}
          alt=""
          widths={[400, 800]}
          sizes="100vw"
          loading="eager"
          class="article-photo-bg"
          aria-hidden="true"
        />
        <Image
          src={imageMap[article.imageKey]}
          alt={article.title}
          widths={[800, 1200, 1600]}
          sizes="(max-width: 1024px) 100vw, 1200px"
          loading="eager"
          class="article-photo"
        />
      </div>
    </div>
  </div>

  <!-- Article body -->
  <section class="article-section section">
    <div class="container">
      <div class="article-body reveal">
        {article.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="article-back reveal">
        <GlassButton href="/news" variant="outline">← Back to News</GlassButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Feature image */
  .article-photo-band {
    padding-block: clamp(24px, 4vh, 48px);
  }

  .article-photo-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    max-height: 620px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #0a0a0f;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.5),
      inset 0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  .article-photo-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: blur(40px) brightness(0.55) saturate(1.1);
    transform: scale(1.15);
    z-index: 0;
  }

  .article-photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    z-index: 1;
  }

  /* Body text */
  .article-body {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .article-body p {
    font-size: var(--fs-lead);
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .article-back {
    max-width: 780px;
    margin: 48px auto 0;
  }
</style>
