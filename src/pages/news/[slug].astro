---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import GlassButton from "../../components/ui/GlassButton.astro";
import { getNewsBySlug } from "../../lib/server/repositories/news";
import { formatNewsDate, newsBodyToParagraphs } from "../../lib/format";

import ibacImg from "../../assets/photos/NOTICIA IBAC.webp";
import fifaImg from "../../assets/photos/FIFA.webp";
import nbaaImg from "../../assets/photos/NBAA-BACE.webp";

export const prerender = false;

const legacyImageMap: Record<string, ImageMetadata> = {
  ibac: ibacImg,
  fifa: fifaImg,
  nbaa: nbaaImg,
};

const { slug } = Astro.params;
const article = slug ? await getNewsBySlug(slug) : null;

if (!article) {
  return Astro.redirect("/news");
}

const legacyImage = article.imageKey ? legacyImageMap[article.imageKey] : undefined;
const uploadedImage = !legacyImage && article.imageKey ? `/uploads/news/${article.imageKey}` : null;
const paragraphs = newsBodyToParagraphs(article.body);
---

<BaseLayout
  title={`${article.title} — Manny Aero`}
  description={article.excerpt ?? undefined}
  activeLink="news"
>
  <PageHero
    badge={article.category}
    title={article.title}
    subtitle={formatNewsDate(article.date)}
    accent=""
  />

  <!-- Feature image -->
  {(legacyImage || uploadedImage) && (
    <div class="article-photo-band">
      <div class="container">
        <div class="article-photo-wrap reveal">
          {legacyImage ? (
            <Image
              src={legacyImage}
              alt={article.title}
              widths={[800, 1200, 1600]}
              sizes="(max-width: 1024px) 100vw, 1200px"
              loading="eager"
              class="article-photo"
            />
          ) : (
            <img src={uploadedImage!} alt={article.title} class="article-photo" />
          )}
        </div>
      </div>
    </div>
  )}

  <!-- Article body -->
  <section class="article-section section">
    <div class="container">
      <div class="article-body reveal">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="article-back reveal">
        <GlassButton href="/news" variant="outline">← Back to News</GlassButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Feature image */
  .article-photo-band {
    padding-block: clamp(24px, 4vh, 48px);
  }

  .article-photo-wrap {
    position: relative;
    aspect-ratio: 5 / 4;
    max-height: 720px;
    max-width: 900px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.5),
      inset 0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  .article-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Body text */
  .article-body {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .article-body p {
    font-size: var(--fs-lead);
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .article-back {
    max-width: 780px;
    margin: 48px auto 0;
  }
</style>
