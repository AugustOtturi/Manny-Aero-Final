---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listLeads } from "../../lib/server/repositories/leads";

export const prerender = false;

const { rows, total } = await listLeads({ limit: 50 });
---

<AdminLayout title="Leads" active="leads">
  <main class="page">
    <header class="page__header">
      <h1>Leads</h1>
      <a href="/api/admin/leads/export" class="page__export">Exportar CSV</a>
    </header>

    <div class="filters">
      <select id="type-filter">
        <option value="">Todos los tipos</option>
        <option value="contact">Contacto</option>
        <option value="gate">Descarga de permiso</option>
      </select>
      <input type="search" id="search-filter" placeholder="Buscar por email…" />
    </div>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Empresa</th>
            <th>Detalle</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="leads-body">
          {rows.map((l) => (
            <tr data-id={l.id} data-lead={JSON.stringify(l)}>
              <td class="muted">{new Date(l.createdAt).toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short" })}</td>
              <td><span class={`badge badge--${l.type}`}>{l.type === "contact" ? "Contacto" : "Gate"}</span></td>
              <td>{[l.firstName, l.lastName].filter(Boolean).join(" ") || "—"}</td>
              <td>{l.email}</td>
              <td class="muted">{l.company || "—"}</td>
              <td class="muted">{l.type === "gate" ? l.fileName : l.service || "—"}</td>
              <td class="actions">
                <button class="view-btn" data-id={l.id}>Ver</button>
                <button class="delete-btn" data-id={l.id}>Eliminar</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {rows.length === 0 && <p class="empty">No hay leads todavía.</p>}
    </div>
    <p class="total" id="total-count">{total} lead(s) en total</p>
  </main>

  <div class="lead-overlay" id="lead-overlay" hidden>
    <div class="lead-modal" role="dialog" aria-modal="true" aria-labelledby="lead-modal-title">
      <button type="button" class="lead-modal__close" id="lead-modal-close" aria-label="Cerrar">&times;</button>
      <h2 class="lead-modal__title" id="lead-modal-title">Detalle del lead</h2>
      <div id="lead-modal-body" class="lead-modal__body"></div>
    </div>
  </div>
</AdminLayout>

<script>
  interface Lead {
    id: number;
    type: "contact" | "gate";
    email: string;
    firstName: string | null;
    lastName: string | null;
    phone: string | null;
    company: string | null;
    service: string | null;
    aircraft: string | null;
    flights: unknown;
    notes: string | null;
    fileName: string | null;
    createdAt: string;
  }

  const tbody = document.getElementById("leads-body")!;
  const typeFilter = document.getElementById("type-filter") as HTMLSelectElement;
  const searchFilter = document.getElementById("search-filter") as HTMLInputElement;
  const totalCount = document.getElementById("total-count")!;

  const leadsById = new Map<number, Lead>();
  tbody.querySelectorAll<HTMLElement>("tr[data-lead]").forEach((tr) => {
    const lead = JSON.parse(tr.dataset.lead || "{}") as Lead;
    leadsById.set(lead.id, lead);
  });

  function badgeLabel(type: string) {
    return type === "contact" ? "Contacto" : "Gate";
  }

  function esc(value: unknown): string {
    return String(value ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string)
    );
  }

  function renderRows(leads: Lead[]) {
    tbody.innerHTML = "";
    leadsById.clear();
    for (const l of leads) {
      leadsById.set(l.id, l);
      const tr = document.createElement("tr");
      tr.dataset.id = String(l.id);
      const date = new Date(l.createdAt).toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short" });
      const name = [l.firstName, l.lastName].filter(Boolean).join(" ") || "—";
      const detail = l.type === "gate" ? (l.fileName || "—") : (l.service || "—");
      tr.innerHTML = `
        <td class="muted">${esc(date)}</td>
        <td><span class="badge badge--${l.type}">${badgeLabel(l.type)}</span></td>
        <td>${esc(name)}</td>
        <td>${esc(l.email)}</td>
        <td class="muted">${esc(l.company || "—")}</td>
        <td class="muted">${esc(detail)}</td>
        <td class="actions">
          <button class="view-btn" data-id="${l.id}">Ver</button>
          <button class="delete-btn" data-id="${l.id}">Eliminar</button>
        </td>
      `;
      tbody.appendChild(tr);
    }
  }

  async function refresh() {
    const params = new URLSearchParams();
    if (typeFilter.value) params.set("type", typeFilter.value);
    if (searchFilter.value.trim()) params.set("search", searchFilter.value.trim());

    const res = await fetch(`/api/admin/leads?${params.toString()}`);
    const data = await res.json();
    if (data.ok) {
      renderRows(data.leads);
      totalCount.textContent = `${data.total} lead(s) en total`;
    }
  }

  let debounceTimer: ReturnType<typeof setTimeout>;
  typeFilter.addEventListener("change", refresh);
  searchFilter.addEventListener("input", () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(refresh, 300);
  });

  // ── Detail modal ──────────────────────────────────────────
  const leadOverlay = document.getElementById("lead-overlay")!;
  const leadModalBody = document.getElementById("lead-modal-body")!;
  const leadModalClose = document.getElementById("lead-modal-close")!;

  function row(label: string, value: string | null | undefined): string {
    if (!value) return "";
    return `<div class="lead-row"><span class="lead-row__label">${esc(label)}</span><span class="lead-row__value">${value}</span></div>`;
  }

  function openLeadModal(lead: Lead) {
    const name = [lead.firstName, lead.lastName].filter(Boolean).join(" ");
    const date = new Date(lead.createdAt).toLocaleString("es-MX", { dateStyle: "long", timeStyle: "short" });

    let flightsHtml = "";
    if (Array.isArray(lead.flights) && lead.flights.length > 0) {
      const cards = lead.flights
        .map((f, i) => {
          if (typeof f !== "object" || f === null) return "";
          const entries = Object.entries(f as Record<string, unknown>)
            .filter(([, v]) => String(v ?? "").trim() !== "")
            .map(([k, v]) => row(k, esc(String(v))))
            .join("");
          if (!entries) return "";
          return `<div class="lead-flight"><div class="lead-flight__title">Vuelo ${i + 1}</div>${entries}</div>`;
        })
        .join("");
      if (cards) flightsHtml = `<div class="lead-section"><h3>Vuelos</h3>${cards}</div>`;
    }

    const sections = [
      `<div class="lead-section">
        <h3>${lead.type === "contact" ? "Operador" : "Lead"}</h3>
        ${row("Nombre", esc(name))}
        ${row("Email", `<a href="mailto:${esc(lead.email)}">${esc(lead.email)}</a>`)}
        ${row("Teléfono", esc(lead.phone))}
        ${row("Empresa", esc(lead.company))}
      </div>`,
      lead.type === "contact"
        ? `<div class="lead-section">
            <h3>Servicio solicitado</h3>
            ${row("Servicio", esc(lead.service))}
            ${row("Tipo de aeronave", esc(lead.aircraft))}
          </div>`
        : `<div class="lead-section">
            <h3>Archivo</h3>
            ${row("Nombre del archivo", esc(lead.fileName))}
          </div>`,
      flightsHtml,
      lead.notes
        ? `<div class="lead-section"><h3>Notas</h3><p class="lead-notes">${esc(lead.notes).replace(/\n/g, "<br>")}</p></div>`
        : "",
      `<div class="lead-section lead-section--meta">${row("Recibido", esc(date))}</div>`,
    ].join("");

    leadModalBody.innerHTML = sections;
    leadOverlay.hidden = false;
  }

  function closeLeadModal() {
    leadOverlay.hidden = true;
  }

  leadModalClose.addEventListener("click", closeLeadModal);
  leadOverlay.addEventListener("click", (e) => {
    if (e.target === leadOverlay) closeLeadModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !leadOverlay.hidden) closeLeadModal();
  });

  tbody.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;

    const viewBtn = target.closest<HTMLButtonElement>(".view-btn");
    if (viewBtn) {
      const id = Number(viewBtn.dataset.id);
      const lead = leadsById.get(id);
      if (lead) openLeadModal(lead);
      return;
    }

    const deleteBtn = target.closest<HTMLButtonElement>(".delete-btn");
    if (deleteBtn) {
      const id = deleteBtn.dataset.id;
      if (!id) return;
      const ok = await window.adminConfirm("Esta acción no se puede deshacer.", {
        title: "¿Eliminar este lead?",
        confirmLabel: "Eliminar",
      });
      if (!ok) return;

      const res = await fetch(`/api/admin/leads/${id}`, { method: "DELETE" });
      if (res.ok) {
        deleteBtn.closest("tr")?.remove();
        leadsById.delete(Number(id));
      } else {
        await window.adminAlert("No se pudo eliminar el lead.");
      }
    }
  });
</script>

<style>
  .page {
    padding: 40px 32px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .page__header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .page__header h1 {
    font-family: var(--font-display);
    font-size: 28px;
    margin: 0;
    flex: 1;
  }

  .page__export {
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
    font-size: 13px;
    text-decoration: none;
  }

  .page__export:hover {
    border-color: var(--color-accent);
  }

  .filters {
    display: flex;
    gap: 12px;
    margin-bottom: 18px;
  }

  .filters select,
  .filters input {
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text);
  }

  .filters select option {
    background: #26262a;
    color: #ffffff;
  }

  .filters input {
    flex: 1;
    max-width: 280px;
  }

  .filters input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .table-wrap {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: auto;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
  }

  .table th,
  .table td {
    text-align: left;
    padding: 12px 16px;
    font-size: 13px;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .table th {
    color: var(--color-text-muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .table tr:last-child td {
    border-bottom: none;
  }

  .muted {
    color: var(--color-text-muted);
  }

  .badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
  }

  .badge--contact {
    background: rgba(255, 185, 0, 0.15);
    color: var(--color-accent);
  }

  .badge--gate {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    gap: 14px;
  }

  .view-btn {
    background: none;
    border: none;
    color: var(--color-accent);
    font-size: 13px;
    cursor: pointer;
    padding: 0;
  }

  .delete-btn {
    background: none;
    border: none;
    color: #ff6b6b;
    font-size: 13px;
    cursor: pointer;
    padding: 0;
  }

  .empty {
    padding: 32px;
    text-align: center;
    color: var(--color-text-muted);
  }

  .total {
    margin-top: 14px;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* Detail modal */
  .lead-overlay[hidden] {
    display: none;
  }

  .lead-overlay {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .lead-modal {
    position: relative;
    width: 100%;
    max-width: 560px;
    max-height: 85vh;
    overflow-y: auto;
    background: #26262a;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    padding: 32px;
    box-shadow: var(--shadow-card-lg);
  }

  .lead-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .lead-modal__close:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .lead-modal__title {
    font-family: var(--font-display);
    font-size: 22px;
    margin: 0 0 20px;
  }

  /* .lead-modal__body content is injected via innerHTML in <script>, so
     Astro's scoped-CSS attribute never lands on it — these rules must be
     :global() or they silently no-op (found the hard way: labels/values
     rendered with zero styling, all run together on one line). */
  :global(.lead-section) {
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.lead-section:last-child) {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  :global(.lead-section h3) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 12px;
  }

  :global(.lead-row) {
    display: flex;
    gap: 12px;
    font-size: 13px;
    padding: 4px 0;
  }

  :global(.lead-row__label) {
    width: 130px;
    flex-shrink: 0;
    color: var(--color-text-muted);
    opacity: 0.75;
  }

  :global(.lead-row__value) {
    color: var(--color-text);
    word-break: break-word;
  }

  :global(.lead-row__value a) {
    color: var(--color-accent);
  }

  :global(.lead-flight) {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    margin-bottom: 10px;
  }

  :global(.lead-flight__title) {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 6px;
  }

  :global(.lead-notes) {
    font-size: 13px;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
  }
</style>
