---
import { Image } from "astro:assets";
import { AIRPORT_OPTIONS } from "../data/airportOptions";

import Logo1 from "../assets/Logo1.webp";
import Logo2 from "../assets/Logo2.png";
import Logo3 from "../assets/Logo3.png";
import Logo4 from "../assets/Logo4.png";
import Logo5 from "../assets/Logo5.png";
import Logo6 from "../assets/Logo6.png";
import Logo7 from "../assets/Logo7.png";
import Logo8 from "../assets/Logo8.png";

const PARTNERS = [
  { logo: Logo1, name: "FIA World Rally Championship" },
  { logo: Logo2, name: "World Wide Technology Championship" },
  { logo: Logo3, name: "Event partner" },
  { logo: Logo4, name: "Event partner" },
  { logo: Logo5, name: "Event partner" },
  { logo: Logo6, name: "Mexico Open at Vidanta" },
  { logo: Logo7, name: "Event partner" },
  { logo: Logo8, name: "FIFA World Cup" },
];

// Duplicate the list for seamless marquee loop
const marqueeItems = [...PARTNERS, ...PARTNERS];

const airportOptions = AIRPORT_OPTIONS;
---

<section class="final section" id="contact" aria-labelledby="final-title">
  <div class="container">
    <div class="final__intro reveal">
      <h2 id="final-title" class="final__title">
        Seamless Approvals for <br />
        <span class="accent">Mexico's Premier Events</span>
      </h2>
      <p class="final__lead">
        From landing approvals to aircraft parking, Manny ensures a smooth
        experience for Mexico's most important events.
      </p>
    </div>
  </div>

  <div class="marquee reveal" aria-label="Events we support">
    <div class="marquee__track">
      {
        marqueeItems.map((item, i) => (
          <span
            class="marquee__item"
            aria-hidden={i >= PARTNERS.length ? "true" : "false"}
          >
            <Image
              src={item.logo}
              alt={i >= PARTNERS.length ? "" : item.name}
              widths={[120, 200, 280]}
              sizes="(max-width: 640px) 120px, (max-width: 1024px) 180px, 220px"
              loading="lazy"
              decoding="async"
              class="marquee__logo"
            />
          </span>
        ))
      }
    </div>
  </div>

  <div class="container">
    <div class="final__form reveal">
      <header class="form-header">
        <h3 class="form-header__title">Ready for <span class="accent">take off?</span></h3>
        <p class="form-header__lead">24/7 response — every request handled with precision.</p>
      </header>

      <div class="form-card" id="finalFormCard">

        <form
          id="form"
          class="form"
          action="#"
          method="post"
          novalidate
        >
          {/* Honeypot — hidden from humans, bots fill it automatically */}
          <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label class="field">
            <span>Name</span>
            <input type="text" name="name" required autocomplete="name" placeholder="John Smith" />
          </label>

          <label class="field">
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
          </label>

          <label class="field">
            <span>Phone</span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="+1 555 123 4567" />
          </label>

          <label class="field">
            <span>Company</span>
            <input type="text" name="company" autocomplete="organization" placeholder="Aviation Company LLC" />
          </label>

          <div class="flights field--full" data-flights>
            <button type="button" class="flights__add" data-flights-add>
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path
                  d="M9 3V15M3 9H15"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
              Add Mission Information
            </button>

            <p class="flights__hint">
              Optional — share flight details so we can prepare everything in advance.
            </p>

            <div class="flights__list" data-flights-list></div>
          </div>

          <label class="field field--full">
            <span>Leave us a message</span>
            <textarea name="message" rows="5" required placeholder="e.g. 4 PAX arriving MMTO on Apr 28 at 14:30Z — need ground handling and catering for crew of 2."></textarea>
          </label>

          <div class="form__actions field--full">
            <button class="form__submit" type="submit">
              Send Message
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path
                  d="M3 9H15M15 9L10 4M15 9L10 14"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>

          <p class="form__status field--full" data-form-status aria-live="polite"></p>
        </form>
      </div>

      <div class="final-success" id="finalSuccess" aria-live="polite">
        <div class="success-inner">
          <div class="success-check">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div class="success-title">Request received</div>
          <p class="success-desc">
            Thank you — your request has been sent to our operations team.
          </p>
          <div class="success-timeline">
            <div class="timeline-item">
              <span class="timeline-label">Contact</span>
              <span class="timeline-value"><a href="tel:+527222730981">MEX +52 722 273 0981</a> · <a href="tel:+18775062669">US 1 877 50 MANNY</a></span>
            </div>
          </div>
          <a href="/" class="success-cta">
            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            Back to Home
          </a>
        </div>
      </div>

      <div class="final-error" id="finalError" aria-live="assertive">
        <div class="error-inner">
          <div class="error-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </div>
          <div class="error-title">Request failed</div>
          <p class="error-desc" id="finalErrorDesc">
            We couldn't send your request. Please try again or contact us directly.
          </p>
          <div class="error-timeline">
            <div class="timeline-item">
              <span class="timeline-label">Direct Phone</span>
              <span class="timeline-value"><a href="tel:+527222730981">MEX +52 722 273 0981</a> · <a href="tel:+18775062669">US 1 877 50 MANNY</a></span>
            </div>
            <div class="timeline-item">
              <span class="timeline-label">Email</span>
              <span class="timeline-value"><a href="mailto:ops@manny.aero">ops@manny.aero</a></span>
            </div>
          </div>
          <div class="error-actions">
            <button type="button" class="error-cta error-cta--primary" id="finalErrorRetry">
              <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
              Try again
            </button>
            <a href="tel:+527222730981" class="error-cta error-cta--secondary">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              Call us directly
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<template id="flight-template">
  <details class="flight" open>
    <summary class="flight__header">
      <span class="flight__chevron" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M3 5L6 8L9 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="flight__title" data-flight-title>Flight 1</span>
      <button type="button" class="flight__remove" aria-label="Remove flight" data-flight-remove>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M3 3L11 11M11 3L3 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </summary>

    <div class="flight__body">
      <label class="field">
        <span>PAX</span>
        <input type="number" min="0" inputmode="numeric" data-key="PAX" placeholder="e.g. 4" />
      </label>

      <label class="field">
        <span>Crew</span>
        <input type="number" min="0" inputmode="numeric" data-key="CREW" placeholder="e.g. 2" />
      </label>

      <label class="field">
        <span>Aircraft type</span>
        <input type="text" data-key="AIRCRAFT TYPE" placeholder="e.g. Gulfstream G550" />
      </label>

      <label class="field">
        <span>Tail number</span>
        <input type="text" data-key="TAIL NUMBER" placeholder="e.g. N12345" />
      </label>

      <label class="field">
        <span>Arrival date</span>
        <input type="date" data-key="ARRIVAL DATE" />
      </label>

      <label class="field">
        <span>Arrival time (UTC / Zulu)</span>
        <input type="text" data-key="ARRIVAL TIME" placeholder="e.g. 14:30Z" pattern="^([01]?[0-9]|2[0-3]):[0-5][0-9]Z?$" />
      </label>

      <label class="field">
        <span>Departure date</span>
        <input type="date" data-key="DEPARTURE DATE" />
      </label>

      <label class="field">
        <span>Departure time (UTC / Zulu)</span>
        <input type="text" data-key="DEPARTURE TIME" placeholder="e.g. 18:45Z" pattern="^([01]?[0-9]|2[0-3]):[0-5][0-9]Z?$" />
      </label>

      <label class="field field--select field--full">
        <span>Airport</span>
        <select data-key="AIRPORT">
          <option value="">Select an airport…</option>
        </select>
      </label>
    </div>
  </details>
</template>

<script define:vars={{ airportOptions }}>
  const form = document.getElementById("form");
  const list = form.querySelector("[data-flights-list]");
  const addBtn = form.querySelector("[data-flights-add]");
  const status = form.querySelector("[data-form-status]");
  const template = document.getElementById("flight-template");

  function reindex() {
    list.querySelectorAll(".flight").forEach((flight, i) => {
      const title = flight.querySelector("[data-flight-title]");
      if (title) title.textContent = `Flight ${i + 1}`;
    });
  }

  function addFlight() {
    const node = template.content.cloneNode(true);

    // Populate airport select with options
    const select = node.querySelector('select[data-key="AIRPORT"]');
    for (const opt of airportOptions) {
      const o = document.createElement("option");
      o.value = opt.value;
      o.textContent = opt.label;
      select.appendChild(o);
    }
    const other = document.createElement("option");
    other.value = "Other";
    other.textContent = "Other";
    select.appendChild(other);

    // Collapse all other flights when adding a new one
    list.querySelectorAll(".flight").forEach((f) => {
      f.open = false;
    });

    list.appendChild(node);
    reindex();
  }

  addBtn.addEventListener("click", addFlight);

  list.addEventListener("click", (e) => {
    const removeBtn = e.target.closest("[data-flight-remove]");
    if (removeBtn) {
      e.preventDefault();
      e.stopPropagation();
      removeBtn.closest(".flight")?.remove();
      reindex();
    }
  });

  const submitBtn = form.querySelector(".form__submit");
  const formCard = document.getElementById("finalFormCard");
  const successUI = document.getElementById("finalSuccess");
  const errorUI = document.getElementById("finalError");
  const errorDesc = document.getElementById("finalErrorDesc");
  const errorRetry = document.getElementById("finalErrorRetry");
  const formHeader = document.querySelector(".form-header");

  function showFinalError(msg) {
    if (errorDesc) {
      errorDesc.textContent = msg
        ? `We couldn't send your request: ${msg}. Please try again or contact us directly.`
        : "We couldn't send your request. Please try again or contact us directly.";
    }
    if (formCard)   formCard.style.display = "none";
    if (formHeader) formHeader.style.display = "none";
    errorUI?.classList.add("show");
  }

  function hideFinalError() {
    errorUI?.classList.remove("show");
    if (formCard)   formCard.style.display = "";
    if (formHeader) formHeader.style.display = "";
    if (submitBtn) { submitBtn.disabled = false; submitBtn.style.opacity = ""; }
  }

  errorRetry?.addEventListener("click", () => {
    hideFinalError();
    formCard?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const fd = new FormData(form);

    // Collect flight repeater
    const flights = [];
    list.querySelectorAll(".flight").forEach((flight) => {
      const entry = {};
      flight.querySelectorAll("[data-key]").forEach((input) => {
        if (input.value.trim()) entry[input.dataset.key] = input.value.trim();
      });
      if (Object.keys(entry).length > 0) flights.push(entry);
    });

    const payload = {
      type:    "contact",
      website: (fd.get("website") || "").toString(), // honeypot
      // FinalCTA has a single "name" field — split for the mailer
      firstName: (fd.get("name") || "").toString().trim().split(" ")[0],
      lastName:  (fd.get("name") || "").toString().trim().split(" ").slice(1).join(" ") || ".",
      email:     (fd.get("email")   || "").toString().trim(),
      phone:     (fd.get("phone")   || "").toString().trim(),
      company:   (fd.get("company") || "").toString().trim(),
      notes:     (fd.get("message") || "").toString().trim(),
      flights,
    };

    if (submitBtn) { submitBtn.disabled = true; submitBtn.style.opacity = "0.65"; }

    try {
      const res  = await fetch("/mail.php", {
        method:  "POST",
        headers: { "Content-Type": "application/json" },
        body:    JSON.stringify(payload),
      });
      const json = await res.json();

      if (json.ok) {
        if (formCard)   formCard.style.display = "none";
        if (formHeader) formHeader.style.display = "none";
        successUI?.classList.add("show");
        form.reset();
      } else {
        throw new Error(json.error ?? "Server error");
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : "Unexpected error";
      showFinalError(msg);
    }
  });
</script>

<style>
  /* ── Intro (title + CTA), centered ── */
  .final__intro {
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
  }

  .final__eyebrow {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 16px;
  }

  .final__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 60px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0 0 20px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .final__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 620px;
    margin: 0 auto 32px;
  }

  /* ── Marquee: full-width logo carousel on dark panel (non-interactive) ── */
  .marquee {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-block: clamp(48px, 6vw, 80px);
    padding-block: clamp(20px, 2.4vw, 32px);
    overflow: hidden;
    background: rgba(10, 10, 15, 0.55);
    border-block: 1px solid var(--color-border);
    pointer-events: none;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .marquee__track {
    display: flex;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
    width: max-content;
    animation: marquee 40s linear infinite;
    will-change: transform;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: clamp(40px, 5vw, 64px);
    flex: 0 0 auto;
  }

  .marquee__logo {
    display: block;
    height: 100%;
    width: auto;
    max-width: clamp(120px, 14vw, 200px);
    object-fit: contain;
    opacity: 0.95;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .marquee__item {
      height: 36px;
    }
    .marquee__logo {
      max-width: 110px;
    }
    .marquee__track {
      gap: 28px;
      animation-duration: 28s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }

  /* ── Form card: centered, wider, single column (cascade) ── */
  .final__form {
    max-width: 920px;
    margin: 0 auto;
  }

  /* ── Form header (outside the card) ── */
  .form-header {
    margin-bottom: 20px;
    text-align: center;
  }

  .form-header__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 60px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .form-header__lead {
    font-size: var(--fs-label);
    line-height: 1.45;
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 500;
  }

  /* ── Form card: continuous with the page gradient, subtle highlight ── */
  .form-card {
    position: relative;
    background:
      linear-gradient(
        150deg,
        rgba(110, 110, 118, 0.42) 0%,
        rgba(60, 60, 68, 0.48) 55%,
        rgba(38, 38, 44, 0.55) 100%
      );
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 36px);
    -webkit-backdrop-filter: blur(14px) saturate(1.25);
    backdrop-filter: blur(14px) saturate(1.25);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.4),
      0 8px 24px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  /* Soft top-left sheen to lift the card */
  .form-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 15% 0%,
        rgba(255, 255, 255, 0.1) 0%,
        transparent 55%
      );
    border-radius: inherit;
  }

  .form-card > * {
    position: relative;
    z-index: 1;
  }

  .form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .field--full,
  .form > .field--full,
  .form > .form__actions,
  .form > .form__status,
  .form > .flights {
    grid-column: 1 / -1;
  }

  .field > span {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 600;
  }

  .field input,
  .field textarea,
  .field select {
    padding: 10px 14px;
    background: #f5f5f7;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: #1a1a1f;
    font-size: 14px;
    font-family: var(--font-sans);
    transition: border-color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
    width: 100%;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #6e6e78;
    opacity: 1;
  }

  .field textarea {
    border-radius: var(--radius);
    resize: vertical;
    min-height: 96px;
    line-height: 1.5;
  }

  .field select {
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'><path d='M1 1.5L6 6.5L11 1.5' stroke='%238b8b95' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-color: #f5f5f7;
    background-repeat: no-repeat;
    background-position: right 14px center;
    padding-right: 38px;
    cursor: pointer;
  }

  .field select option {
    background: #f5f5f7;
    color: #1a1a1f;
  }

  .field input:focus,
  .field textarea:focus,
  .field select:focus {
    outline: none;
    border-color: var(--color-accent);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(255, 185, 0, 0.25);
  }

  /* ── Flights repeater ── */
  .flights {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .flights__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .flights__list:empty {
    display: none;
  }

  .flights__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 16px;
    background: rgba(255, 185, 0, 0.08);
    color: var(--color-accent);
    border: 1px dashed rgba(255, 185, 0, 0.45);
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
    align-self: flex-start;
  }

  .flights__add:hover {
    background: rgba(255, 185, 0, 0.16);
    border-color: var(--color-accent);
  }

  .flights__hint {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* ── Single flight (accordion) ── */
  .flight {
    background:
      linear-gradient(
        330deg,
        rgba(30, 30, 36, 0.55) 0%,
        rgba(18, 18, 24, 0.6) 100%
      );
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
  }

