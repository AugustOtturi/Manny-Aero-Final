---
import { Image } from "astro:assets";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { IMAGE_SLOTS } from "../../../lib/imageSlots";
import { listImages } from "../../../lib/server/repositories/images";

import subheroFeature from "../../../assets/photos/subhero-4.webp";
import subheroPhoto1 from "../../../assets/photos/subhero-1.webp";
import subheroPhoto2 from "../../../assets/photos/subhero-2.jpg";
import subheroPhoto3 from "../../../assets/photos/subhero-3.jpg";
import serviceGroundHandling from "../../../assets/photos/groundhandling.jpg";
import servicePermits from "../../../assets/photos/permisyauthoriations.jpg";
import serviceCatering from "../../../assets/photos/mannyscatering.jpg";
import serviceAudits from "../../../assets/photos/isbah2-2.jpg";

export const prerender = false;

const CATEGORY_META: Record<string, { title: string; lead: string }> = {
  subhero: {
    title: 'SubHero — sección "25+ años"',
    lead: "Las 4 imágenes de la sección de experiencia en el home, justo debajo del hero.",
  },
  service: {
    title: "Tarjetas de servicios",
    lead: "Las 4 imágenes de las tarjetas de servicio en el home (Ground Handling, Permits, Catering, IS-BAH).",
  },
};

const DEFAULT_IMAGES: Record<string, ImageMetadata> = {
  "subhero:feature": subheroFeature,
  "subhero:photo-1": subheroPhoto1,
  "subhero:photo-2": subheroPhoto2,
  "subhero:photo-3": subheroPhoto3,
  "service:ground-handling": serviceGroundHandling,
  "service:permits": servicePermits,
  "service:catering": serviceCatering,
  "service:audits": serviceAudits,
};

const category = Astro.params.category ?? "";

if (category === "logo") {
  return Astro.redirect("/admin/images/logos");
}

const meta = CATEGORY_META[category];
if (!meta) {
  return Astro.redirect("/admin/images");
}

const slots = IMAGE_SLOTS.filter((s) => s.category === category);
const overrides = new Map((await listImages(category)).map((row) => [row.slug, row]));
---

<AdminLayout title={meta.title} active="images">
  <main class="page">
    <header class="page__header">
      <a href="/admin/images" class="page__back">← Imágenes</a>
      <h1>{meta.title}</h1>
    </header>
    <p class="page__lead">{meta.lead}</p>

    <div class="stack">
      {slots.map((slot) => {
        const row = overrides.get(slot.slug);
        const currentUrl = row ? `/uploads/${category}/${row.fileName}` : null;
        const defaultImage = DEFAULT_IMAGES[`${category}:${slot.slug}`];
        return (
          <section class="slot" data-slug={slot.slug}>
            <div class="slot__preview">
              {currentUrl ? (
                <img src={currentUrl} alt={slot.label} />
              ) : defaultImage ? (
                <Image src={defaultImage} alt={slot.label} width={220} height={150} />
              ) : (
                <span>Sin imagen</span>
              )}
            </div>
            <div class="slot__form">
              <p class="slot__label">{slot.label}</p>
              <p class="slot__hint">{slot.hint}</p>
              <form class="upload-form">
                <input type="file" accept="image/jpeg,image/png,image/webp" required />
                <button type="submit">Subir imagen</button>
              </form>
              {currentUrl && <button class="revert-btn">Volver a la imagen original</button>}
              <p class="slot__status" hidden></p>
            </div>
          </section>
        );
      })}
    </div>
  </main>
</AdminLayout>

<script define:vars={{ category }}>

  document.querySelectorAll(".slot").forEach((slot) => {
    const slugVal = slot.dataset.slug;
    const form = slot.querySelector(".upload-form");
    const fileInput = form.querySelector('input[type="file"]');
    const status = slot.querySelector(".slot__status");
    const revertBtn = slot.querySelector(".revert-btn");

    function setStatus(msg, isError) {
      status.hidden = false;
      status.textContent = msg;
      status.style.color = isError ? "#ff6b6b" : "var(--color-accent)";
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const file = fileInput.files?.[0];
      if (!file) {
        setStatus("Selecciona un archivo primero.", true);
        return;
      }

      setStatus("Subiendo…");
      const fd = new FormData();
      fd.append("category", category);
      fd.append("slug", slugVal);
      fd.append("file", file);

      try {
        const res = await fetch("/api/admin/images/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || "Error al subir");
        setStatus("Imagen actualizada.");
        window.location.reload();
      } catch (err) {
        setStatus(err instanceof Error ? err.message : "Error inesperado", true);
      }
    });

    revertBtn?.addEventListener("click", async () => {
      const ok = await window.adminConfirm("La imagen personalizada se eliminará.", {
        title: "¿Volver a la imagen original del sitio?",
        confirmLabel: "Restaurar",
        danger: false,
      });
      if (!ok) return;
      setStatus("Restaurando…");
      try {
        const res = await fetch(`/api/admin/images/${category}/${slugVal}`, { method: "DELETE" });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || "Error al restaurar");
        window.location.reload();
      } catch (err) {
        setStatus(err instanceof Error ? err.message : "Error inesperado", true);
      }
    });
  });
</script>

<style>
  .page {
    padding: 40px 32px;
    max-width: 900px;
    margin: 0 auto;
  }

  .page__header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 8px;
  }

  .page__back {
    font-size: 13px;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .page__header h1 {
    font-family: var(--font-display);
    font-size: 26px;
    margin: 0;
  }

  .page__lead {
    color: var(--color-text-muted);
    font-size: 14px;
    margin: 0 0 32px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .slot {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 20px;
  }

  .slot__preview {
    height: 150px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 12px;
    color: var(--color-text-muted);
    text-align: center;
    padding: 8px;
  }

  .slot__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slot__label {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 4px;
  }

  .slot__hint {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 0 0 16px;
  }

  .upload-form {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .upload-form input[type="file"] {
    font-size: 13px;
    color: var(--color-text-muted);
    max-width: 260px;
  }

  .upload-form button {
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: #0a0a0a;
    font-weight: 700;
    font-size: 13px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .revert-btn {
    font-size: 12px;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
  }

  .revert-btn:hover {
    color: var(--color-text);
  }

  .slot__status {
    font-size: 12px;
    margin: 10px 0 0;
  }

  @media (max-width: 640px) {
    .slot {
      grid-template-columns: 1fr;
    }
  }
</style>
