# Copy to .env.local for local development. Never commit the real values.

NODE_ENV=development
PORT=4321

# MySQL (Hostinger provides host/user/pass/db when you create the database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=manny_dev
DB_PASS=
DB_NAME=manny_dev

# SMTP (Office 365 / Outlook, or Hostinger SMTP) — same template mail.php used
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-replay@manny.aero
SMTP_PASS=
MAIL_FROM=no-replay@manny.aero
MAIL_FROM_NAME=Website Form
MAIL_TO_CONTACT=ops@manny.aero
MAIL_TO_GATE=ops@manny.aero
MAIL_CC=

# Admin auth (single user)
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# CSRF / origin check for public form endpoints
ALLOWED_ORIGIN=http://localhost:4321

RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW=3600

# Absolute directory where CMS uploads (images, logos, permit files) are stored
# and served from. In production set this to a persistent path OUTSIDE the
# deploy/git-checkout directory so uploads survive redeploys — otherwise every
# deploy wipes them (public/uploads is gitignored and the repo is re-checked-out
# fresh). Leave empty locally to use ./public/uploads.
# Example (Hostinger): /home/uXXXXXXXX/domains/<domain>/uploads
UPLOADS_DIR=
