---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SubHero from "../components/SubHero.astro";
import ServiceCards from "../components/ServiceCards.astro";
import MapSection from "../components/MapSection.astro";
import FinalCTA from "../components/FinalCTA.astro";
---

<BaseLayout
  title="Aircraft Ground Handling Mexico — Manny Aero"
  description="Manny Aero delivers premium aircraft ground handling, permits & authorizations, in-flight catering, and IS-BAH / IS-BAO audits across Mexico. 24/7 service, 300+ trip providers, 10,000+ operations handled."
  ogImage="/og/ground-handling.webp"
  ogImageAlt="Manny Aero aircraft ground handling operations at a Mexican airport"
  activeLink="home"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Aircraft Ground Handling Mexico",
      "provider": {
        "@type": "Organization",
        "name": "Manny Aero",
        "url": "https://manny.aero"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Mexico"
      },
      "description": "Premium aircraft ground handling, permits & authorizations, in-flight catering, IS-BAH/IS-BAO audits, and FBO coordination across Mexico since 1997.",
      "serviceType": "Aircraft Ground Handling",
      "availableChannel": {
        "@type": "ServiceChannel",
        "serviceUrl": "https://manny.aero/contact",
        "availableLanguage": ["English", "Spanish"],
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      }
    })} />
  </Fragment>
  <Hero />
  <SubHero />
  <ServiceCards />
  <MapSection />
  <FinalCTA />
</BaseLayout>
