---
import AdminLayout from "../../layouts/AdminLayout.astro";

export const prerender = false;

const sections = [
  {
    href: "/admin/images/subhero",
    title: "SubHero",
    desc: "4 imágenes de la sección '25+ años de experiencia' en el home.",
  },
  {
    href: "/admin/images/service",
    title: "Tarjetas de servicios",
    desc: "4 imágenes de las tarjetas de servicio en el home.",
  },
  {
    href: "/admin/images/logos",
    title: "Logos de partners",
    desc: "Carrusel de logos de eventos y partners — agregar, eliminar o editar libremente.",
  },
];
---

<AdminLayout title="Imágenes" active="images">
  <main class="page">
    <h1>Imágenes del index</h1>
    <p class="page__lead">Elige qué grupo de imágenes querés gestionar.</p>

    <div class="grid">
      {sections.map((s) => (
        <a href={s.href} class="card">
          <h2>{s.title}</h2>
          <p class="card__desc">{s.desc}</p>
        </a>
      ))}
    </div>
  </main>
</AdminLayout>

<style>
  .page {
    padding: 40px 32px;
    max-width: 900px;
    margin: 0 auto;
  }

  .page h1 {
    font-family: var(--font-display);
    font-size: 28px;
    margin: 0 0 6px;
  }

  .page__lead {
    color: var(--color-text-muted);
    margin: 0 0 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s var(--ease-out);
  }

  .card:hover {
    border-color: var(--color-accent);
  }

  .card h2 {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--color-text);
    margin: 0;
  }

  .card__desc {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
