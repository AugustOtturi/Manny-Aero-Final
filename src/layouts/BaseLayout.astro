---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FloatingContact from "../components/FloatingContact.astro";
import bebasNeue from "@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url";
import interBold from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";
import aileronRegular from "../assets/fonts/aileron.regular.otf?url";
import { CSP_META } from "../lib/csp";

type ActiveLink = "home" | "about" | "services" | "map" | "news" | "contact";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  robots?: string;
  activeLink?: ActiveLink;
}

const {
  title,
  description = "Manny Aero delivers premium aircraft ground handling, permits & FBO coordination across Mexico. IS-BAH certified. 24/7 ops support since 1997.",
  ogImage = "/og/ground-handling.jpg",
  ogImageAlt = "Manny Aero — Aircraft Ground Handling Services in Mexico",
  robots = "index, follow",
  activeLink = "home",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();

const isHome = activeLink === "home";

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Manny Aero",
  url: Astro.site?.toString(),
  logo: new URL("/logo-manny.svg", Astro.site).toString(),
  foundingDate: "1997",
  description:
    "Premium aircraft ground handling, permits, catering and FBO coordination across Mexico. IS-BAH certified since 2016. Trusted by operators worldwide.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Toluca",
    addressRegion: "Estado de México",
    addressCountry: "MX",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: "+1-877-506-2669",
      contactType: "customer service",
      areaServed: ["US", "CA"],
      availableLanguage: ["English", "Spanish"],
    },
    {
      "@type": "ContactPoint",
      telephone: "+52-722-273-0981",
      contactType: "customer service",
      areaServed: "MX",
      availableLanguage: ["Spanish", "English"],
    },
  ],
  sameAs: [
    "https://www.instagram.com/manny_aero/",
    "https://www.facebook.com/mannyaviation/",
    "https://www.linkedin.com/company/manny-aviation-services/",
    "https://www.youtube.com/@manny_aero",
    "https://www.tiktok.com/@manny.aero",
    "https://x.com/manny_aero",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* CSP via meta because Hostinger's edge overrides response CSP headers.
        Prod-only so it never interferes with the dev server's HMR. */}
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP_META} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0f" />

    <meta name="google-site-verification" content="Gmz_gm8nHb-sMJYx5JMfYynILOqOsMz_Lh0NA0lhp-o" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manny Aero" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_MX" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@manny_aero" />
    <meta name="twitter:creator" content="@manny_aero" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="robots" content={robots} />
    <meta name="geo.region" content="MX-MEX" />
    <meta name="geo.placename" content="Toluca, Estado de México, Mexico" />
    <meta name="geo.position" content="19.2826;-99.5561" />
    <meta name="ICBM" content="19.2826, -99.5561" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preload" href={bebasNeue} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={aileronRegular} as="font" type="font/otf" crossorigin />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgJsonLd)}
    />

    <style is:inline>
      html:not(.is-ready) body {
        overflow: hidden;
      }
      .app-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 28px;
        background: #0a0a0f;
        transition: opacity 0.45s var(--ease-out);
      }
      .app-loader__text {
        font-family: var(--font-display, var(--font-sans), sans-serif);
        font-size: clamp(22px, 3.5vw, 40px);
        font-weight: 400;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        color: var(--color-accent);
        text-shadow: 0 4px 24px rgba(255, 185, 0, 0.25);
        line-height: 1;
        text-align: center;
        margin: 0;
        white-space: nowrap;
      }
      .app-loader__bar {
        position: relative;
        width: 200px;
        height: 1px;
        background: rgba(255, 255, 255, 0.08);
        overflow: hidden;
        border-radius: 999px;
      }
      .app-loader__bar span {
        position: absolute;
        inset: 0;
        background: var(--color-accent);
        transform: translateX(-100%);
        animation: appLoaderBar 1.1s var(--ease-out) forwards;
      }
      @keyframes appLoaderBar {
        to { transform: translateX(0); }
      }
      .app-loader.is-gone {
        opacity: 0;
        pointer-events: none;
      }
      @media (max-width: 640px) {
        .app-loader__bar {
          width: 160px;
        }
      }
    </style>

    <slot name="head" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8Y9BB0Z7JW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8Y9BB0Z7JW');
    </script>
  </head>
  <body data-active-link={activeLink}>
    {isHome && (
      <div class="app-loader" id="app-loader" aria-hidden="true">
        <p class="app-loader__text">
          <span>With Manny, Mexico is yours</span>
        </p>
        <div class="app-loader__bar"><span></span></div>
      </div>
    )}

    <script is:inline define:vars={{ isHome }}>
      (function () {
        if (!isHome) {
          document.documentElement.classList.add("is-ready");
          return;
        }

        var loader = document.getElementById("app-loader");
        var start = performance.now();
        var MIN_SHOW = 1100;
        var prefersReduced =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var finished = false;

        function finish() {
          if (finished) return;
          finished = true;
          var elapsed = performance.now() - start;
          var wait = prefersReduced ? 0 : Math.max(0, MIN_SHOW - elapsed);
          setTimeout(function () {
            document.documentElement.classList.add("is-ready");
            if (!loader) return;
            loader.classList.add("is-gone");
            var removed = false;
            var remove = function () {
              if (removed) return;
              removed = true;
              if (loader && loader.parentNode) loader.parentNode.removeChild(loader);
            };
            loader.addEventListener("transitionend", remove, { once: true });
            setTimeout(remove, 900);
          }, wait);
        }

        if (document.readyState === "complete") {
          finish();
        } else {
          window.addEventListener("load", finish, { once: true });
          // Safety net — load may never fire if an embedded iframe stalls.
          setTimeout(finish, 6000);
        }
      })();
    </script>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="grain">
        <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </svg>

    <div class="bg-blobs" aria-hidden="true">
      <span class="blob blob--right blob--1"></span>
      <span class="blob blob--right blob--2"></span>
      <span class="blob blob--left  blob--3"></span>
    </div>
    <div class="bg-noise" aria-hidden="true"></div>

    <Navbar activeLink={activeLink} />

    <main id="main">
      <slot />
    </main>

    <FloatingContact />

    <Footer />

    <script>
      // Navbar scroll state + scroll-reveal observer
      const body = document.body;
      let ticking = false;

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            body.dataset.scrolled = window.scrollY > 40 ? "true" : "false";
            ticking = false;
          });
          ticking = true;
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // Reveal on scroll
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (!prefersReducedMotion && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in-view");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -4% 0px", threshold: 0.04 }
        );
        document.querySelectorAll<HTMLElement>(".reveal, .stagger").forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll<HTMLElement>(".reveal, .stagger").forEach((el) =>
          el.classList.add("in-view")
        );
      }
    </script>
  </body>
</html>
